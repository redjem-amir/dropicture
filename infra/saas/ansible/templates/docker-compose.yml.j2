## dropicture/infra/saas/ansible/templates/docker-compose.yml.j2
services:
  proxy:
    image: traefik:v3.7.4
    networks:
      - frontend
      - socket
      - monitoring
    ports:
      - { target: 80, published: 80, protocol: tcp, mode: host }
      - { target: 443, published: 443, protocol: tcp, mode: host }
    command:
      - --entryPoints.web.address=:80
      - --entryPoints.web.http.redirections.entryPoint.to=websecure
      - --entryPoints.web.http.redirections.entryPoint.scheme=https
      - --entryPoints.websecure.address=:443
      - --entryPoints.websecure.transport.respondingTimeouts.readTimeout=600s
      - --entryPoints.websecure.transport.respondingTimeouts.writeTimeout=600s
      - --entryPoints.websecure.transport.respondingTimeouts.idleTimeout=180s
      - --entryPoints.metrics.address=:8082
      - --entryPoints.websecure.forwardedHeaders.trustedIPs={{ cloudflare_trusted_ips | join(',') }}
      - --metrics.prometheus=true
      - --metrics.prometheus.entryPoint=metrics
      - --metrics.prometheus.addEntryPointsLabels=true
      - --metrics.prometheus.addServicesLabels=true
      - --metrics.prometheus.addRoutersLabels=true
      - --ping=true
      - --providers.swarm.endpoint=tcp://socket-proxy:2375
      - --providers.swarm.exposedByDefault=false
      - --providers.swarm.network=dropicture_frontend
      - --providers.swarm.refreshSeconds=15
      - --providers.file.filename=/etc/traefik/dynamic/tls.yml
      - --providers.file.watch=true
      - --api.dashboard=false
      - --log.level=INFO
      - --accesslog=true
    configs:
      - { source: traefik_dynamic, target: /etc/traefik/dynamic/tls.yml }
      - { source: origin_cert, target: /etc/traefik/certs/origin.crt }
    secrets:
      - { source: origin_key, target: origin.key }
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 15s
      timeout: 3s
      retries: 3
      start_period: 10s
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.labels.dropicture.role == proxy
      update_config:
        parallelism: 1
        order: stop-first
        monitor: 15s
        failure_action: rollback
      rollback_config:
        parallelism: 1
        order: stop-first
      restart_policy:
        condition: any
        delay: 5s
        window: 30s
      resources:
        reservations: { cpus: "0.10", memory: 64M }
        limits: { cpus: "0.75", memory: 256M }

  socket-proxy:
    image: tecnativa/docker-socket-proxy:v0.4.2
    networks:
      - socket
    environment:
      SWARM: "1"
      SERVICES: "1"
      TASKS: "1"
      NETWORKS: "1"
      NODES: "1"
      INFO: "1"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:2375/version"]
      interval: 15s
      timeout: 3s
      retries: 3
      start_period: 10s
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.role == manager
      update_config:
        parallelism: 1
        order: start-first
        monitor: 15s
        failure_action: rollback
      rollback_config:
        parallelism: 1
        order: start-first
      restart_policy:
        condition: any
        delay: 5s
        window: 30s
      resources:
        reservations: { cpus: "0.02", memory: 8M }
        limits: { cpus: "0.10", memory: 32M }

  dropicture-saas-frontend:
    image: ghcr.io/redjem-amir/dropicture/saas/frontend:{{ lookup('env', 'FRONTEND_IMAGE_TAG') | default('latest', true) }}
    networks:
      - frontend
    environment:
      NEXT_PUBLIC_API_URL: "{{ lookup('env', 'NEXT_PUBLIC_API_URL') }}"
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:3001/"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
    deploy:
      replicas: {{ frontend_replicas | default(1) }}
      placement:
        constraints:
          - node.labels.dropicture.role == frontend
      labels:
        - traefik.enable=true
        - traefik.http.routers.frontend.rule=Host(`app.dropicture.com`)
        - traefik.http.routers.frontend.entrypoints=websecure
        - traefik.http.routers.frontend.tls=true
        - traefik.http.routers.frontend.priority=1
        - traefik.http.services.frontend.loadbalancer.server.port=3001
        - traefik.http.services.frontend.loadbalancer.strategy=p2c
        - traefik.http.services.frontend.loadbalancer.healthcheck.path=/
        - traefik.http.services.frontend.loadbalancer.healthcheck.interval=10s
      update_config:
        parallelism: 1
        order: start-first
        monitor: 30s
        failure_action: rollback
      rollback_config:
        parallelism: 1
        order: start-first
      restart_policy:
        condition: any
        delay: 5s
        window: 30s
      resources:
        reservations: { cpus: "0.20", memory: 256M }
        limits: { cpus: "0.85", memory: 960M }

  dropicture-saas-backend:
    image: ghcr.io/redjem-amir/dropicture/saas/backend:{{ lookup('env', 'BACKEND_IMAGE_TAG') | default('latest', true) }}
    networks:
      - frontend
      - backend
      - egress
    environment:
      PGBOUNCER_HOST_DROPICTURE_SAAS: dropicture-saas-pgbouncer
      POSTGRES_PORT_DROPICTURE_SAAS: "5432"
      PGBOUNCER_PORT_DROPICTURE_SAAS: "6432"
      POSTGRES_DB_DROPICTURE_SAAS: "{{ lookup('env', 'POSTGRES_DB_DROPICTURE_SAAS') }}"
      POSTGRES_USER_DROPICTURE_SAAS: "{{ lookup('env', 'POSTGRES_USER_DROPICTURE_SAAS') }}"
      POSTGRES_PASSWORD_DROPICTURE_SAAS: "{{ lookup('env', 'POSTGRES_PASSWORD_DROPICTURE_SAAS') | replace('$', '$$') }}"
      REDIS_CACHE_HOST_DROPICTURE_SAAS: dropicture-saas-redis-cache
      AWS_REGION: "{{ lookup('env', 'AWS_REGION') | default('eu-west-3', true) }}"
      AWS_ACCESS_KEY_ID: "{{ lookup('env', 'AWS_ACCESS_KEY_ID') }}"
      AWS_SECRET_ACCESS_KEY: "{{ lookup('env', 'AWS_SECRET_ACCESS_KEY') | replace('$', '$$') }}"
      CDN_SSM_PREFIX: /dropicture/cloudfront
      COOKIE_DOMAIN: .dropicture.com
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:3002/health"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
    stop_grace_period: 2m
    deploy:
      replicas: {{ backend_replicas | default(1) }}
      placement:
        constraints:
          - node.labels.dropicture.role == backend
      labels:
        - traefik.enable=true
        - traefik.http.routers.backend.rule=Host(`app.dropicture.com`) && PathPrefix(`/api`)
        - traefik.http.routers.backend.entrypoints=websecure
        - traefik.http.routers.backend.tls=true
        - traefik.http.routers.backend.priority=100
        - traefik.http.services.backend.loadbalancer.server.port=3002
        - traefik.http.services.backend.loadbalancer.strategy=p2c
        - traefik.http.services.backend.loadbalancer.healthcheck.path=/health
        - traefik.http.services.backend.loadbalancer.healthcheck.interval=10s
      update_config:
        parallelism: 1
        order: start-first
        monitor: 30s
        failure_action: rollback
      rollback_config:
        parallelism: 1
        order: start-first
      restart_policy:
        condition: any
        delay: 5s
        window: 30s
      resources:
        reservations: { cpus: "0.20", memory: 384M }
        limits: { cpus: "0.85", memory: 1280M }

  dropicture-saas-pgbouncer:
    image: edoburu/pgbouncer:v1.24.1-p1
    networks:
      - backend
    environment:
      DB_HOST: dropicture-saas-postgres
      DB_PORT: "5432"
      DB_NAME: "{{ lookup('env', 'POSTGRES_DB_DROPICTURE_SAAS') }}"
      DB_USER: "{{ lookup('env', 'POSTGRES_USER_DROPICTURE_SAAS') }}"
      DB_PASSWORD: "{{ lookup('env', 'POSTGRES_PASSWORD_DROPICTURE_SAAS') | replace('$', '$$') }}"
      LISTEN_PORT: "6432"
      AUTH_TYPE: scram-sha-256
      POOL_MODE: transaction
      DEFAULT_POOL_SIZE: "25"
      MIN_POOL_SIZE: "5"
      RESERVE_POOL_SIZE: "5"
      RESERVE_POOL_TIMEOUT: "3"
      MAX_CLIENT_CONN: "1000"
      MAX_PREPARED_STATEMENTS: "200"
      IGNORE_STARTUP_PARAMETERS: extra_float_digits
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -p 6432 -U $$DB_USER -d $$DB_NAME"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 15s
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.labels.dropicture.role == db
      update_config:
        parallelism: 1
        order: stop-first
        monitor: 30s
        failure_action: rollback
      rollback_config:
        parallelism: 1
        order: stop-first
      restart_policy:
        condition: any
        delay: 5s
        window: 30s
      resources:
        reservations: { cpus: "0.10", memory: 32M }
        limits: { cpus: "0.50", memory: 128M }

  dropicture-saas-postgres:
    image: postgres:18.4
    networks:
      - backend
    environment:
      POSTGRES_DB: "{{ lookup('env', 'POSTGRES_DB_DROPICTURE_SAAS') }}"
      POSTGRES_USER: "{{ lookup('env', 'POSTGRES_USER_DROPICTURE_SAAS') }}"
      POSTGRES_PASSWORD: "{{ lookup('env', 'POSTGRES_PASSWORD_DROPICTURE_SAAS') | replace('$', '$$') }}"
    command:
      - "postgres"
      - "-c"
      - "max_connections=100"
      - "-c"
      - "shared_buffers=2GB"
      - "-c"
      - "effective_cache_size=4500MB"
      - "-c"
      - "maintenance_work_mem=512MB"
      - "-c"
      - "work_mem=12MB"
      - "-c"
      - "max_wal_size=2GB"
      - "-c"
      - "min_wal_size=256MB"
      - "-c"
      - "max_parallel_workers_per_gather=2"
      - "-c"
      - "random_page_cost=1.1"
    volumes:
      - /opt/dropicture/data/postgres:/var/lib/postgresql
      - type: tmpfs
        target: /dev/shm
        tmpfs: { size: 536870912 }
    stop_grace_period: 1m
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.labels.dropicture.role == db
      update_config:
        parallelism: 1
        order: stop-first
        monitor: 30s
      restart_policy:
        condition: any
        delay: 5s
        window: 60s
      resources:
        reservations: { cpus: "1.00", memory: 2G }
        limits: { cpus: "3.40", memory: 6G }

  dropicture-saas-redis-cache:
    image: redis:8.8.0-alpine
    command:
      - "redis-server"
      - "--protected-mode"
      - "no"
      - "--maxmemory"
      - "512mb"
      - "--maxmemory-policy"
      - "allkeys-lru"
      - "--save"
      - "1800"
      - "1"
      - "--dir"
      - "/data"
    networks:
      - backend
    volumes:
      - /opt/dropicture/data/redis:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.labels.dropicture.role == proxy
      update_config:
        parallelism: 1
        order: stop-first
        monitor: 30s
      restart_policy:
        condition: any
        delay: 5s
        window: 60s
      resources:
        reservations: { cpus: "0.10", memory: 96M }
        limits: { cpus: "0.50", memory: 896M }

  prometheus:
    image: prom/prometheus:v3.13.1
    networks:
      - monitoring
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=15d
      - --storage.tsdb.retention.size=10GB
      - --web.enable-lifecycle
    configs:
      - { source: prometheus_config, target: /etc/prometheus/prometheus.yml }
    volumes:
      - /opt/dropicture/data/prometheus:/prometheus
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.labels.dropicture.role == proxy
      update_config:
        parallelism: 1
        order: stop-first
        monitor: 30s
      restart_policy:
        condition: any
        delay: 5s
        window: 60s
      resources:
        reservations: { cpus: "0.20", memory: 256M }
        limits: { cpus: "1.00", memory: 1G }

  loki:
    image: grafana/loki:3.7.3
    networks:
      - monitoring
    command:
      - -config.file=/etc/loki/config.yml
    configs:
      - { source: loki_config, target: /etc/loki/config.yml }
    volumes:
      - /opt/dropicture/data/loki:/loki
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.labels.dropicture.role == proxy
      update_config:
        parallelism: 1
        order: stop-first
        monitor: 30s
      restart_policy:
        condition: any
        delay: 5s
        window: 60s
      resources:
        reservations: { cpus: "0.15", memory: 192M }
        limits: { cpus: "0.75", memory: 640M }

  grafana:
    image: grafana/grafana:13.1.0
    networks:
      - monitoring
      - frontend
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: "{{ lookup('env', 'GRAFANA_ADMIN_PASSWORD') | replace('$', '$$') }}"
      GF_SERVER_ROOT_URL: https://grafana.dropicture.com
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_NEWS_NEWS_FEED_ENABLED: "false"
    configs:
      - { source: grafana_datasources, target: /etc/grafana/provisioning/datasources/datasources.yml }
      - { source: grafana_dashboards_provider, target: /etc/grafana/provisioning/dashboards/dashboards.yml }
      - { source: dashboard_overview, target: /etc/grafana/dashboards/dropicture-overview.json }
      - { source: dashboard_logs, target: /etc/grafana/dashboards/dropicture-logs.json }
    volumes:
      - /opt/dropicture/data/grafana:/var/lib/grafana
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.labels.dropicture.role == proxy
      labels:
        - traefik.enable=true
        - traefik.http.routers.grafana.rule=Host(`grafana.dropicture.com`)
        - traefik.http.routers.grafana.entrypoints=websecure
        - traefik.http.routers.grafana.tls=true
        - traefik.http.services.grafana.loadbalancer.server.port=3000
        - traefik.http.services.grafana.loadbalancer.healthcheck.path=/api/health
        - traefik.http.services.grafana.loadbalancer.healthcheck.interval=10s
      update_config:
        parallelism: 1
        order: stop-first
        monitor: 30s
      restart_policy:
        condition: any
        delay: 5s
        window: 60s
      resources:
        reservations: { cpus: "0.15", memory: 192M }
        limits: { cpus: "0.75", memory: 640M }

  node-exporter:
    image: prom/node-exporter:v1.12.0
    networks:
      - monitoring
    ports:
      - { target: 9100, published: 9100, protocol: tcp, mode: host }
    command:
      - --path.procfs=/host/proc
      - --path.sysfs=/host/sys
      - --path.rootfs=/host/root
      - --collector.filesystem.mount-points-exclude=^/(dev|proc|sys|run|var/lib/docker/.+)($$|/)
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/host/root:ro
    deploy:
      mode: global
      restart_policy:
        condition: any
        delay: 5s
      resources:
        reservations: { cpus: "0.02", memory: 16M }
        limits: { cpus: "0.10", memory: 64M }

  cadvisor:
    image: ghcr.io/google/cadvisor:v0.60.5
    networks:
      - monitoring
    ports:
      - { target: 8080, published: 8080, protocol: tcp, mode: host }
    command:
      - --docker_only=true
      - --housekeeping_interval=30s
      - --store_container_labels=false
      - --whitelisted_container_labels=com.docker.swarm.service.name,com.docker.stack.namespace
      - --disable_metrics=percpu,sched,tcp,udp,advtcp,process,hugetlb,referenced_memory,cpu_topology,resctrl
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    deploy:
      mode: global
      restart_policy:
        condition: any
        delay: 5s
      resources:
        reservations: { cpus: "0.05", memory: 32M }
        limits: { cpus: "0.20", memory: 192M }

  alloy:
    image: grafana/alloy:v1.16.3
    hostname: "{% raw %}{{.Node.Hostname}}{% endraw %}"
    networks:
      - monitoring
    command:
      - run
      - --server.http.listen-addr=0.0.0.0:12345
      - --storage.path=/var/lib/alloy/data
      - /etc/alloy/config.alloy
    user: root
    configs:
      - { source: alloy_config, target: /etc/alloy/config.alloy }
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /opt/dropicture/data/alloy:/var/lib/alloy/data
    deploy:
      mode: global
      restart_policy:
        condition: any
        delay: 5s
      resources:
        reservations: { cpus: "0.05", memory: 32M }
        limits: { cpus: "0.20", memory: 160M }

networks:
  frontend:
    driver: overlay
    driver_opts:
      com.docker.network.driver.mtu: "1400"
  backend:
    driver: overlay
    internal: true
    attachable: true
    driver_opts:
      com.docker.network.driver.mtu: "1400"
  socket:
    driver: overlay
    internal: true
    driver_opts:
      com.docker.network.driver.mtu: "1400"
  egress:
    driver: overlay
    driver_opts:
      com.docker.network.driver.mtu: "1400"
  monitoring:
    driver: overlay
    driver_opts:
      com.docker.network.driver.mtu: "1400"

configs:
  traefik_dynamic:
    external: true
    name: dropicture_traefik_dynamic_v1
  origin_cert:
    external: true
    name: dropicture_origin_cert
  prometheus_config:
    name: dropicture_prometheus_{{ cfg_hash.prometheus }}
    file: /opt/dropicture/stacks/prometheus.yml
  loki_config:
    name: dropicture_loki_{{ cfg_hash.loki }}
    file: /opt/dropicture/stacks/loki.yml
  alloy_config:
    name: dropicture_alloy_{{ cfg_hash.alloy }}
    file: /opt/dropicture/stacks/alloy.alloy
  grafana_datasources:
    name: dropicture_grafana_ds_{{ cfg_hash.grafana_ds }}
    file: /opt/dropicture/stacks/grafana-datasources.yml
  grafana_dashboards_provider:
    name: dropicture_grafana_dashprov_{{ cfg_hash.grafana_dash_provider }}
    file: /opt/dropicture/stacks/grafana-dashboards.yml
  dashboard_overview:
    name: dropicture_dash_overview_{{ cfg_hash.dash_overview }}
    file: /opt/dropicture/stacks/dashboards/dropicture-overview.json
  dashboard_logs:
    name: dropicture_dash_logs_{{ cfg_hash.dash_logs }}
    file: /opt/dropicture/stacks/dashboards/dropicture-logs.json

secrets:
  origin_key:
    external: true
    name: dropicture_origin_key