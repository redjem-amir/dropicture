                <mxCell id="n75" value="Les exceptions vivent dans &lt;b&gt;.trivyignore&lt;/b&gt; et doivent porter identifiant, motif et date de revue. Le fichier est aujourd&#39;hui vide de toute exception active." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff3bf;strokeColor=#f59f00;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
                    <mxGeometry x="82" y="890" width="716" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="n76" value="TRAÇABILITÉ DE LA CHAÎNE D&#39;APPROVISIONNEMENT" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e5dbff;strokeColor=#7048e8;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#7048e8" parent="1" vertex="1">
                    <mxGeometry x="850" y="660" width="750" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="n77" value="&lt;b&gt;SBOM CycloneDX,&lt;/b&gt;&amp;nbsp;une nomenclature complète par image publiée, archivée 90 jours en artefact de run. Elle permet de répondre en minutes à « suis-je exposé à cette CVE ? » sans reconstruire l&#39;image." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="872" y="696" width="706" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="n78" value="&lt;b&gt;Rapports SARIF,&lt;/b&gt;&amp;nbsp;dépôt et images, publiés dans GitHub Code Scanning, l&#39;historique des vulnérabilités devient consultable et comparable dans le temps." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="872" y="752" width="706" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="n79" value="&lt;b&gt;Image immuable,&lt;/b&gt;&amp;nbsp;l&#39;étiquette est le SHA du dernier commit touchant le service. Ce qui tourne en production est donc rattachable à une ligne de code, sans ambiguïté." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="872" y="808" width="706" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="n80" value="&lt;b&gt;Perspective,&lt;/b&gt;&amp;nbsp;exploiter les SBOM déjà produites pour une veille continue au-delà de l&#39;instant de construction (inscrit au plan d&#39;amélioration continue)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="872" y="864" width="706" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="n81" value="Sources : .github/workflows/saas-deploy.yml · .trivyignore · .husky/pre-commit · apps/saas/*/Dockerfile · infra/saas/ansible/*.yml" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#adb5bd" parent="1" vertex="1">
                    <mxGeometry x="60" y="930" width="1200" height="18" as="geometry"/>
