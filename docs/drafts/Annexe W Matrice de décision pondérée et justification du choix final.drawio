        <mxCell id="c61" value="Elle l'emporte parce qu'elle est la seule à combler un gap qui touche l'ensemble du public visé et non une fraction, tout en étant la moins coûteuse à implémenter. Elle devient la règle de gestion structurante, énoncée au niveau métier de la cartographie (Annexe A) et vérifiée par une suite de tests dédiée (Annexe Z)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529" parent="1" vertex="1">
          <mxGeometry x="54" y="372" width="1546" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c62" value="KF2 et KF3 ne sont pas écartées, elles sont reclassées en fonctions de soutien et livrées dans le même périmètre, KF2 rend la publication visible sans coût de diffusion, KF3 rend la promesse de réversibilité vérifiable. Cet ordre est repris dans la matrice MoSCoW (Annexe X) et le découpage des lots (Annexe L). Limite assumée, les notes des concurrents reposent sur leur documentation publique, non sur un audit interne." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=9;fontColor=#495057" parent="1" vertex="1">
          <mxGeometry x="40" y="448" width="1574" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="c63" value="CRITÈRES DU RÉFÉRENTIEL COUVERTS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ebfbee;strokeColor=#2f9e44;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#2f9e44" parent="1" vertex="1">
