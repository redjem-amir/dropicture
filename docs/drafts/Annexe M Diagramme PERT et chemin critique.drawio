                <mxCell id="n69" value="CHEMIN CRITIQUE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe3e3;strokeColor=#e03131;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#e03131" parent="1" vertex="1">
                    <mxGeometry x="60" y="800" width="740" height="214" as="geometry"/>
                </mxCell>
                <mxCell id="n70" value="A  →  C  →  D  →  F  →  H  =  24 + 37 + 25 + 21 + 15  =  &lt;b&gt;122 jours ouvrés&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe3e3;strokeColor=#e03131;strokeWidth=1.6;fontFamily=Helvetica;fontSize=14;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
                    <mxGeometry x="82" y="838" width="696" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="n71" value="Tout retard sur l&#39;un de ces cinq lots décale mécaniquement la date de fin. Ce sont eux qui reçoivent l&#39;affectation prioritaire des ressources et la vigilance de suivi la plus serrée." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
                    <mxGeometry x="82" y="886" width="696" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="n72" value="Les trois lots hors chemin critique disposent d&#39;une marge,&amp;nbsp;&lt;b&gt;B&lt;/b&gt; Infrastructure IaC (6 j), &lt;b&gt;E&lt;/b&gt; Frontend &amp; site (25 j), &lt;b&gt;G&lt;/b&gt; Sécurité &amp; conformité (34 j). Information décisive le jour où il faut arbitrer sous tension." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e9fac8;strokeColor=#74b816;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
                    <mxGeometry x="82" y="932" width="696" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="n73" value="CHARGE ET DURÉE, pourquoi les deux diffèrent" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d0ebff;strokeColor=#1c7ed6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#1c7ed6" parent="1" vertex="1">
                    <mxGeometry x="830" y="800" width="770" height="214" as="geometry"/>
                </mxCell>
                <mxCell id="n74" value="La &lt;b&gt;charge&lt;/b&gt; (jours-homme, cf. Annexe L) mesure l&#39;effort, la &lt;b&gt;durée&lt;/b&gt; (jours ouvrés, ici) mesure le délai. Elles coïncident quand un seul acteur porte le lot à temps plein, et divergent quand deux acteurs y travaillent en parallèle, ce qui est le cas des lots C, E, G et H. Le second acteur est le développeur applicatif sur C et E, le redevable du lot sur G et H (cf. Annexe L bis)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
                    <mxGeometry x="852" y="838" width="726" height="42" as="geometry"/>
                </mxCell>
