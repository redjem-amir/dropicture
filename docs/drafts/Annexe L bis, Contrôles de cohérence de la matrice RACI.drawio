                <mxCell id="c37" value="✓" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#2f9e44;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#2f9e44;align=center;verticalAlign=middle;spacing=6;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="52" y="730" width="22" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c38" value="La matrice RACI est clairement annotée avec les abréviations" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="76" y="730" width="760" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c39" value="Page 1, section 1 · légende des six symboles R, A, C, I, A/R et non impliqué, avec le sens retenu pour chacun" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="838" y="730" width="764" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c40" value="✓" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#2f9e44;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#2f9e44;align=center;verticalAlign=middle;spacing=6;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="52" y="756" width="22" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c41" value="Les catégories (R, A, C, I) sont remplies avec une distribution équilibrée" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="76" y="756" width="760" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c42" value="Page 1, section 3 · distribution comptée par acteur, quatre acteurs porteurs d&#39;au moins un A, aucun lot sans R" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="838" y="756" width="764" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c43" value="✓" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#2f9e44;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#2f9e44;align=center;verticalAlign=middle;spacing=6;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="52" y="782" width="22" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c44" value="Les outils collaboratifs utilisés permettent une communication fluide entre toutes les parties prenantes et un management inclusif" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="76" y="782" width="760" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c45" value="Page 2, section 1, règle 5 · comptes rendus écrits systématiques · outillage détaillé en Annexe T" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="838" y="782" width="764" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c46" value="✓" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#2f9e44;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#2f9e44;align=center;verticalAlign=middle;spacing=6;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="52" y="808" width="22" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c47" value="La matrice d&#39;engagement répertorie les causes du niveau d&#39;engagement et les actions à entreprendre, en prenant en compte les situations de handicap" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="76" y="808" width="760" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c48" value="Annexe O bis · WCAG 2.2 et RGAA 4 appliqués aux supports de pilotage, rappelés ici par la règle 5" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="838" y="808" width="764" height="24" as="geometry"/>
