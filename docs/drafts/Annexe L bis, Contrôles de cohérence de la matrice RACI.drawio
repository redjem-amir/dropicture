                <mxCell id="c51" value="Page 2, section 1, règle 4 · cohérence vérifiée avec le chemin critique de l&#39;Annexe M et la structure de découpage de l&#39;Annexe L" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
