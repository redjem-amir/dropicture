        <mxCell id="c133" value="Un traitement de données personnelles se révèle non conforme (durée excessive, transfert hors Union européenne, droit non servi), avec un risque de sanction et d'atteinte à la réputation." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
