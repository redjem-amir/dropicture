                <mxCell id="c104" value="Le contrat sert de source unique pour les tests d&#39;intégration de contrôleur et pour l&#39;intégration côté interface (cf. Annexe Z)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
