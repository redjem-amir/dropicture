                <mxCell id="c2" value="dropicture · seize schémas de ressources, conventions de pagination, d&#39;erreur et de limitation de débit · principe fondateur du privé par défaut" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#868e96" parent="1" vertex="1">
