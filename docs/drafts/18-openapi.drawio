                <mxCell id="c1" value="Annexe Q, Modèle de ressources exposées et conventions du contrat (BC2 C13, BC3 C25)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#212529;fontStyle=1" parent="1" vertex="1">
