                <mxCell id="n136" value="0,05 vCPU&lt;br/&gt;32 Mo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
                    <mxGeometry x="1156" y="888" width="106" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="n137" value="0,20 vCPU&lt;br/&gt;160 Mo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
                    <mxGeometry x="1266" y="888" width="106" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="n138" value="LECTURE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d0ebff;strokeColor=#1c7ed6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#1c7ed6" parent="1" vertex="1">
                    <mxGeometry x="60" y="960" width="760" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="n139" value="&lt;b&gt;Placement&lt;/b&gt;&amp;nbsp;&lt;i&gt;node.labels.dropicture.role&lt;/i&gt; est posé par Ansible à partir du rôle Terraform. Un service dont le nœud manque reste &lt;i&gt;Pending,&lt;/i&gt;&amp;nbsp;le playbook vérifie donc que les quatre rôles existent avant tout déploiement." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="82" y="996" width="716" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="n140" value="&lt;b&gt;start-first vs stop-first&lt;/b&gt;&amp;nbsp;les services sans état basculent sans coupure, les singletons attachés à un port hôte ou à un volume s&#39;arrêtent d&#39;abord, faute de quoi deux instances se disputeraient la même ressource." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="82" y="1046" width="716" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="n141" value="&lt;b&gt;Sondes&lt;/b&gt;&amp;nbsp;la sonde de conteneur conditionne le succès du rolling update, Traefik ajoute sa propre sonde de service (/ et /health) pour ne router que vers des tâches saines." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="82" y="1096" width="716" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="n142" value="CONFIGS ET SECRETS SWARM" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe3e3;strokeColor=#e03131;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#e03131" parent="1" vertex="1">
                    <mxGeometry x="840" y="960" width="760" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="n143" value="&lt;b&gt;Secret&lt;/b&gt; &lt;i&gt;dropicture_origin_key&lt;/i&gt; (externe), clé privée du certificat d&#39;origine, montée dans Traefik sous /run/secrets. Elle ne quitte jamais le manager et n&#39;apparaît dans aucun fichier rendu." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="862" y="996" width="716" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="n144" value="&lt;b&gt;Configs externes,&lt;/b&gt;&amp;nbsp;&lt;i&gt;dropicture_origin_cert&lt;/i&gt; et &lt;i&gt;dropicture_traefik_dynamic_v1&lt;/i&gt;, créées par le playbook. Une config Swarm étant immuable, toute rotation impose un changement de nom." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="862" y="1046" width="716" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="n145" value="&lt;b&gt;Configs versionnées par empreinte,&lt;/b&gt;&amp;nbsp;chaque fichier d&#39;observabilité est publié sous le nom &lt;i&gt;dropicture_objet_sha1,&lt;/i&gt;&amp;nbsp;modifier le fichier crée une nouvelle config et déclenche mécaniquement la mise à jour du service." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="862" y="1096" width="716" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="n146" value="Sources, infra/saas/ansible/templates/docker-compose.yml.j2 · infra/saas/ansible/deploy.yml" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#adb5bd" parent="1" vertex="1">
                    <mxGeometry x="60" y="1136" width="1100" height="20" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
