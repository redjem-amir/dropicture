                <mxCell id="n63" value="clé d&#39;accès IAM, état Terraform, S3, SSM, CloudFront, ACM, WAF, Budgets" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
