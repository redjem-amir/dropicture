                <mxCell id="n46" value="&lt;b&gt;Pré-vol&lt;/b&gt;&amp;nbsp;les variables d&#39;environnement requises et les sorties Terraform sont vérifiées avant toute modification (assert, quiet)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="1144" y="392" width="432" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="n47" value="&lt;b&gt;Refus de déployer&lt;/b&gt; sur un Swarm non provisionné, les configs et le secret d&#39;origine doivent exister sur le manager." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="1144" y="462" width="432" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="n48" value="&lt;b&gt;Adresse privée&lt;/b&gt;&amp;nbsp;si le Swarm annonce une adresse obsolète, le playbook s&#39;arrête et documente la procédure de reprise." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="1144" y="532" width="432" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="n49" value="&lt;b&gt;Réconciliation&lt;/b&gt;&amp;nbsp;un nœud n&#39;est retiré du Swarm que si tous les nœuds gérés ont répondu, sinon la réconciliation est refusée." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="1144" y="602" width="432" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="n50" value="&lt;b&gt;Certificat&lt;/b&gt;&amp;nbsp;une config Swarm est immuable, toute divergence entre le certificat sur disque et celui du Swarm bloque le déploiement." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="1144" y="672" width="432" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="n51" value="&lt;b&gt;Migrations&lt;/b&gt;&amp;nbsp;exécutées après le déploiement, dans un conteneur jetable sur le réseau &lt;i&gt;backend&lt;/i&gt;, avec l&#39;image qui vient d&#39;être publiée." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="1144" y="742" width="432" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="n52" value="MISE À JOUR SANS INTERRUPTION" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#2f9e44;dashed=1;dashPattern=8 4" parent="1" vertex="1">
                    <mxGeometry x="60" y="860" width="760" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="n53" value="start-first" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=center;verticalAlign=middle;spacing=6;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="84" y="900" width="220" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="n54" value="backend, frontend, socket-proxy, la nouvelle tâche démarre&lt;br&gt;et devient saine avant l&#39;arrêt de l&#39;ancienne" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
                    <mxGeometry x="314" y="900" width="482" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="n55" value="stop-first" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=center;verticalAlign=middle;spacing=6;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="84" y="968" width="220" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="n56" value="Traefik, Postgres, PgBouncer, pile d&#39;observabilité :&lt;br/&gt;singletons attachés à un port ou à un volume" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
                    <mxGeometry x="314" y="968" width="482" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="n57" value="failure_action: rollback" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=center;verticalAlign=middle;spacing=6;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="84" y="1036" width="220" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="n58" value="fenêtre de surveillance de 15 à 30 s, en cas d&#39;échec,&lt;br&gt;retour automatique à la version précédente" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
                    <mxGeometry x="314" y="1036" width="482" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="n59" value="CHEMINS D&#39;ACCÈS PRIVILÉGIÉS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe8cc;strokeColor=#f76707;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#f76707;dashed=1;dashPattern=8 4" parent="1" vertex="1">
                    <mxGeometry x="850" y="860" width="750" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="n60" value="Runner → nœuds" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe8cc;strokeColor=#f76707;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6;fontStyle=1" parent="1" vertex="1">
