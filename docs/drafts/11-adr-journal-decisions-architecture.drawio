          <mxGeometry x="40" y="78" width="1574" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;ADR-001&lt;/b&gt;  ·  &lt;b&gt;Monorepo unique pour le code applicatif et l'infrastructure&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dbe4ff;strokeColor=#4263eb;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="40" y="118" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c5" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/02/10&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#4263eb;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="640" y="122" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="156" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c7" value="Le projet réunit trois applications (API, application authentifiée, site vitrine) et deux périmètres d'infrastructure décrits en code. Une démarche GitOps suppose que l'état désiré du système soit décrit dans un dépôt qui fait autorité." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="156" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="208" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c9" value="Regrouper les trois applications, le code Terraform et Ansible, les pipelines et la documentation dans un dépôt unique organisé en apps/ et infra/." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="208" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="260" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c11" value="Dépôts séparés par application, avec synchronisation par sous-modules ou par un outil de release coordonné, écartés parce qu'ils dissocient le code livré de l'infrastructure qui l'exécute, et rendent impossible un commit décrivant à la fois « ce qui tourne » et « où cela tourne »." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="260" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="316" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c13" value="Un commit unique décrit l'ensemble du système. Le pipeline peut dériver mécaniquement quelle image reconstruire à partir des chemins modifiés. En contrepartie, les droits d'accès sont uniformes sur l'ensemble du dépôt et la taille de l'historique croît plus vite." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="316" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;ADR-002&lt;/b&gt;  ·  &lt;b&gt;Pile TypeScript unifiée du backend au site vitrine&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dbe4ff;strokeColor=#4263eb;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="832" y="118" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c15" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/02/10&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#4263eb;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1432" y="122" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="156" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c17" value="Une équipe resserrée paie comptant toute fragmentation de compétences. Le produit exige à la fois une API transactionnelle, une application authentifiée rendue côté serveur et un site public statique." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="156" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="208" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c19" value="Retenir TypeScript de bout en bout, NestJS 11 pour l'API, Next.js 16 pour l'application authentifiée et pour le site vitrine (en export statique)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="208" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c20" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="260" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c21" value="Backend en Go ou en Java Spring Boot, écartés pour le coût cognitif d'un second écosystème d'outillage, de test et de qualité, sans bénéfice décisif à cette échelle. Socle Express nu ou Fastify seul, écartés au profit de l'ossature de NestJS (injection de dépendances, modularité par domaine, canaux de validation)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="260" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c22" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="316" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c23" value="Un seul outillage de qualité, une seule culture de test, des types partagés entre couches. En contrepartie, la plateforme reste liée à la trajectoire de l'écosystème Node/TypeScript." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="316" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c24" value="&lt;b&gt;ADR-003&lt;/b&gt;  ·  &lt;b&gt;Bun comme moteur d'exécution, Node.js conservé comme repli&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dbe4ff;strokeColor=#4263eb;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="40" y="372" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c25" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/02/12&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#4263eb;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="640" y="376" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c26" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="410" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c27" value="Le moteur d'exécution engage la vitesse du cycle de développement, la stabilité en production et le risque de dépendance à un éditeur." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="410" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c28" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="462" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c29" value="Exécuter le backend et les images de conteneur sous Bun 1.3, qui réunit runtime, gestionnaire de paquets et lanceur de tests dans un seul binaire." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="462" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c30" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="514" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c31" value="Node.js LTS, écosystème le plus large et comportement en production abondamment documenté, mais installation et suite de tests plus lentes et outillage éclaté. Deno, dont le bénéfice de sécurité par permissions explicites ne compense pas la distance à l'écosystème NestJS." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="514" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c32" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="570" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c33" value="Le gain de cycle se constate à chaque exécution du pipeline et les images sont plus légères. Le risque est borné, le code NestJS reste exécutable sous Node.js sans modification, ce qui constitue une trajectoire de repli documentée. Point de vigilance, gouvernance portée par une seule société." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="570" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c34" value="&lt;b&gt;ADR-004&lt;/b&gt;  ·  &lt;b&gt;Monolithe modulaire plutôt que microservices&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dbe4ff;strokeColor=#4263eb;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="832" y="372" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c35" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/02/13&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#4263eb;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1432" y="376" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c36" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="410" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c37" value="Le domaine compte cinq entités et six périmètres fonctionnels, opérés par une équipe réduite. Le style architectural commande le coût d'exploitation autant que la structure du code." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="410" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c38" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="462" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c39" value="Adopter un monolithe modulaire déployé en conteneurs, décomposé par domaine (un contrôleur par périmètre, trois services injectables transverses), dont les parties sont séparées par des réseaux cloisonnés." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="462" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c40" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="514" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c41" value="Microservices, écartés pour un surcoût opérationnel et énergétique disproportionné (cohérence distribuée, latence réseau, observabilité plus lourde). Architecture sans serveur, incompatible avec le téléversement de médias volumineux en flux et porteuse d'un verrouillage fournisseur marqué. Architecture orientée événements, pertinente en cible pour le post-traitement des médias, non pour le cœur transactionnel." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="514" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c42" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#4263eb;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="570" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c43" value="Déploiement unitaire simple, transactions ACID natives, empreinte de ressources minimale. Le couplage est neutralisé par la décomposition par domaine et l'injection de dépendances, la mise à l'échelle par bloc est absorbée par la réplication horizontale des nœuds sans état. Le choix reste réversible, extraire un domaine ne demanderait pas de refonte." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="570" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c44" value="&lt;b&gt;ADR-005&lt;/b&gt;  ·  &lt;b&gt;Docker Swarm plutôt que Kubernetes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e5dbff;strokeColor=#7048e8;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="40" y="626" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c45" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/02/14&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#7048e8;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#7048e8;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="640" y="630" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c46" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#7048e8;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="664" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c47" value="Le cluster compte quatre nœuds et l'équipe est réduite. Kubernetes est le standard de l'industrie, ce qui rend la question intéressante, le standard n'est pas toujours proportionné au besoin." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="664" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c48" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#7048e8;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="716" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c49" value="Orchestrer avec Docker Swarm, intégré au moteur Docker, placement par contraintes, mise à jour progressive avec retour arrière automatique, secrets et configs natifs, réseaux overlay cloisonnables, sondes de santé et mise à l'échelle horizontale." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="716" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c50" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#7048e8;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="768" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c51" value="Kubernetes, écarté à cette échelle pour le coût permanent, humain et matériel, de son plan de contrôle, sans contrepartie fonctionnelle décisive, conservé comme cible si le trafic ou l'équipe croissent. k3s, écarté parce qu'il allège la machine et non le travail. Nomad, écarté pour un risque de licence (BSL depuis 2023) au regard d'un gain marginal." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="768" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c52" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#7048e8;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="824" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c53" value="Couverture du besoin réel pour une surcharge d'exploitation minimale. Absence de mise à l'échelle automatique et écosystème plus étroit, assumés. La réversibilité est préservée, la pile reste décrite dans un fichier Compose déclaratif et les images sont conformes à l'OCI." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="824" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c54" value="&lt;b&gt;ADR-006&lt;/b&gt;  ·  &lt;b&gt;Terraform pour le provisionnement, Ansible pour la configuration&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e5dbff;strokeColor=#7048e8;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="832" y="626" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c55" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/02/14&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#7048e8;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#7048e8;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1432" y="630" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c56" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#7048e8;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="664" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c57" value="Provisionner des ressources cloud et configurer des systèmes relèvent de deux logiques distinctes, l'une déclarative et convergente, l'autre procédurale et idempotente." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="664" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c58" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#7048e8;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="716" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c59" value="Séparer strictement les deux responsabilités, Terraform crée et détruit les ressources (Hetzner, Cloudflare, AWS) avec un état distant chiffré et verrouillé, Ansible configure les nœuds, initialise le Swarm et déploie la pile." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="716" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c60" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#7048e8;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="768" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c61" value="Tout confier à Ansible (modules cloud), écarté pour l'absence de plan et de gestion d'état. Tout confier à Terraform (provisioners), écarté parce que les provisioners sont explicitement déconseillés et non idempotents." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="768" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c62" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#7048e8;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="824" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c63" value="Lisibilité et reproductibilité améliorées, le plan Terraform devient un instrument de revue avant application. L'inventaire Ansible est dérivé de l'état Terraform, ce qui supprime tout inventaire statique à maintenir. Le suivi de la licence Terraform (BSL depuis 2023) a conduit à documenter OpenTofu comme trajectoire de repli, à syntaxe compatible." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="824" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c64" value="&lt;b&gt;ADR-007&lt;/b&gt;  ·  &lt;b&gt;Hébergement multi-fournisseurs européen&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e5dbff;strokeColor=#7048e8;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="40" y="880" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c65" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/02/17&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#7048e8;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#7048e8;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="640" y="884" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c66" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#7048e8;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="918" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c67" value="Le Cloud Act américain autorise un accès extraterritorial aux données détenues par un fournisseur de droit américain. Le RGPD impose par ailleurs de maîtriser la localisation des données personnelles. Le coût de calcul des hyperscalers pèse lourd sur un budget contraint." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="918" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c68" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#7048e8;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="970" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c69" value="Répartir, Hetzner Cloud (Allemagne) pour le calcul, Cloudflare pour la périphérie réseau, AWS région eu-west-3 (Paris) pour le stockage objet, la diffusion et les sauvegardes." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="970" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c70" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#7048e8;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="1022" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c71" value="Hyperscaler unique de bout en bout, écarté pour un coût de calcul nettement supérieur, une souveraineté floue et un verrouillage fort. Plateforme managée (PaaS), écartée pour une maîtrise des coûts faible à la croissance et un apprentissage DevOps réduit à néant." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="1022" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c72" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#7048e8;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="1078" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c73" value="Chaque besoin est traité par le fournisseur le plus compétitif, le calcul reste européen à faible coût et l'exposition aux services américains se limite au stockage et à la diffusion, dans une région française. En contrepartie, les secrets sont répartis sur trois fournisseurs et trois consoles sont à surveiller, point de vigilance tracé, centralisation à prévoir." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="1078" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c74" value="&lt;b&gt;ADR-008&lt;/b&gt;  ·  &lt;b&gt;PostgreSQL avec un ORM à migrations explicites&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#c3fae8;strokeColor=#099268;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="832" y="880" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c75" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/02/18&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#099268;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1432" y="884" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c76" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="918" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c77" value="Le domaine est relationnel et transactionnel. La sobriété du schéma et la maîtrise des index sont des leviers directs d'éco-conception." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="918" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c78" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="970" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c79" value="Retenir PostgreSQL 18, exploité via TypeORM avec des migrations versionnées et rejouées automatiquement au déploiement. La synchronisation automatique du schéma est désactivée." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="970" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c80" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="1022" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c81" value="Base à schéma implicite (document), écartée pour la perte de contrôle sur les index, en particulier les index partiels, et sur l'intégrité référentielle. Migrations générées à la volée en production, écartées pour l'absence de revue et de reproductibilité." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="1022" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c82" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="1078" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c83" value="Le schéma est reproductible d'un environnement à l'autre et auditable dans l'historique Git. Les contraintes d'intégrité (cascade, CHECK, unicité partielle) sont portées par la base, pas seulement par le code. En contrepartie, toute évolution de schéma exige d'écrire une migration." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="1078" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c84" value="Sources : code et infrastructure du dépôt dropicture (apps/, infra/, .github/workflows/) · le statut « Acceptée » signifie que la décision est en vigueur. Une décision remplacée porterait le statut « Remplacée par ADR-xxx » et resterait au journal, car un journal dont on retire les entrées périmées perd sa raison d'être." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#adb5bd" parent="1" vertex="1">
          <mxGeometry x="40" y="1139" width="1574" height="18" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-3" name="Fiches ADR-009 à ADR-016">
    <mxGraphModel dx="888" dy="621" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="Annexe J, Fiches de décision ADR-009 à ADR-016 (BC1 C5 à C9)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#212529;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="26" width="1574" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="dropicture · format Contexte, Décision, Alternatives écartées avec le motif du rejet, Conséquences assumées y compris défavorables" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#868e96" parent="1" vertex="1">
          <mxGeometry x="40" y="56" width="1574" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="RNCP40573 · Expert en informatique et systèmes d'information, option DevOps · Amir Redjem · appelée en §11.1.1, §11.1.2 et §13.3.2 du mémoire" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9.5;fontColor=#adb5bd" parent="1" vertex="1">
          <mxGeometry x="40" y="78" width="1574" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;ADR-009&lt;/b&gt;  ·  &lt;b&gt;PgBouncer en mutualisation par transaction devant PostgreSQL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#c3fae8;strokeColor=#099268;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="40" y="118" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c5" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/02/19&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#099268;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="640" y="122" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="156" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c7" value="En mise à l'échelle horizontale, plusieurs instances du backend coexistent. Sans mutualisation, chacune monopolise des connexions physiques et sature rapidement le serveur de base." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="156" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="208" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c9" value="Interposer PgBouncer entre les processus applicatifs et PostgreSQL, en mode de mutualisation par transaction (pool de 25, 1 000 clients au plus). Le pool applicatif est lui-même borné et assorti de délais de garde explicites." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="208" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="260" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c11" value="Connexion directe à PostgreSQL, écartée pour la saturation en mise à l'échelle. Mutualisation par session, écartée car elle n'apporte pas le facteur de partage recherché." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="260" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="316" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c13" value="Un nombre restreint de connexions physiques dessert un nombre élevé de clients. En contrepartie, les fonctionnalités liées à la session (curseurs nommés, requêtes préparées non gérées) sont contraintes, ce qui impose de vérifier la compatibilité de l'ORM." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="316" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;ADR-010&lt;/b&gt;  ·  &lt;b&gt;Sessions opaques adossées à Redis plutôt que jetons JWT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe3e3;strokeColor=#e03131;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="832" y="118" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c15" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/02/20&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#e03131;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1432" y="122" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="156" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c17" value="Le produit repose sur la confidentialité. Un jeton autoporteur ne peut pas être révoqué avant son expiration, et son contenu est lisible par le client." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="156" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="208" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c19" value="Émettre un cookie opaque « identifiant de session . nonce », httpOnly, adossé à un enregistrement Redis. Expiration glissante de 30 min, absolue de 8 h, fenêtre d'accès de 5 min. Rotation du nonce protégée par un verrou, fenêtre de grâce de 30 s, détection de rejeu et révocation globale par versionnement de jeton." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="208" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c20" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="260" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c21" value="JWT signé avec liste de révocation, écarté, la liste de révocation revient à réintroduire un état serveur, sans le bénéfice de simplicité du jeton autoporteur. Session en mémoire du processus, écartée car incompatible avec plusieurs réplicas." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="260" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c22" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="316" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c23" value="Révocation immédiate et globale possible (changement de mot de passe, vol présumé). Le navigateur ne détient aucune donnée exploitable. En contrepartie, chaque requête protégée implique une lecture Redis, et la disponibilité de Redis devient critique pour l'authentification." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="316" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c24" value="&lt;b&gt;ADR-011&lt;/b&gt;  ·  &lt;b&gt;Argon2id pour l'empreinte des mots de passe&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe3e3;strokeColor=#e03131;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="40" y="372" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c25" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/02/20&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#e03131;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="640" y="376" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c26" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="410" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c27" value="Le stockage des mots de passe est le point de défaillance dont les conséquences sont les plus graves et les plus durables." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="410" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c28" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="462" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c29" value="Utiliser Argon2id (mémoire 19 Mio, itérations 2, parallélisme 1, sortie 32 octets), conformément aux paramètres recommandés par l'OWASP. Le champ est exclu des lectures par défaut au niveau du modèle." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="462" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c30" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="514" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c31" value="bcrypt, robuste mais moins résistant aux attaques matérielles parallélisées. PBKDF2, retenu par certains référentiels mais moins exigeant en mémoire, donc plus vulnérable au calcul massivement parallèle." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="514" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c32" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="570" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c33" value="Résistance élevée aux attaques par dictionnaire matériel. Coût processeur et mémoire assumé à chaque connexion, ce qui a justifié un débit limité à dix tentatives par minute. Une vérification leurre est exécutée pour les comptes inconnus, afin que le temps de réponse ne permette pas de les énumérer." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="570" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c34" value="&lt;b&gt;ADR-012&lt;/b&gt;  ·  &lt;b&gt;Téléversement en flux vers le stockage objet, sans buffer mémoire&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d0ebff;strokeColor=#1c7ed6;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="832" y="372" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c35" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/02/24&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#1c7ed6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1432" y="376" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c36" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="410" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c37" value="Une vidéo peut atteindre 100 Mo. Bufferiser le corps de la requête exposerait le processus à un épuisement mémoire et contredirait l'exigence d'éco-conception." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="410" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c38" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="462" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c39" value="Piloter le corps de la requête en flux vers S3 en mode multipart (tranches de 5 Mo, deux en parallèle). Un transformateur compte les octets à la volée et rompt le flux dès le dépassement du seuil, l'envoi est alors abandonné et l'objet partiel supprimé." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="462" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c40" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="514" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c41" value="Réception intégrale en mémoire puis envoi, écartée pour l'empreinte mémoire. Écriture sur disque local puis envoi différé, écartée car elle réintroduit un état sur des nœuds voulus sans état." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="514" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c42" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="570" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c43" value="L'empreinte mémoire reste bornée quelle que soit la taille du fichier, et aucun objet orphelin ne subsiste dans le bucket en cas d'échec. En contrepartie, la taille réelle n'est connue qu'à la fin du transfert, d'où un contrôle préalable, indicatif sur l'en-tête Content-Length." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="570" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c44" value="&lt;b&gt;ADR-013&lt;/b&gt;  ·  &lt;b&gt;La publication est une date, pas une table&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d0ebff;strokeColor=#1c7ed6;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="40" y="626" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c45" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/02/25&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#1c7ed6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="640" y="630" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c46" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="664" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c47" value="La règle fondatrice du produit, privé par défaut, publication explicite et révocable, devait se traduire dans le modèle de données sans duplication ni désynchronisation possible." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="664" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c48" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="716" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c49" value="Porter la visibilité par un unique champ nullable sur le média (« publié le »). La publication est une mise à jour atomique et idempotente qui préserve la date d'origine, la dépublication remet le champ à NULL." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="716" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c50" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="768" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c51" value="Table de publication séparée, écartée pour le risque de désynchronisation et le coût d'une jointure sur le chemin le plus fréquent. Copie du média dans un espace public, écartée pour la duplication de stockage et la difficulté du retrait." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="768" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c52" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="824" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c53" value="Le partage devient un basculement d'état simple et réversible. La galerie publique s'appuie sur un index partiel qui ne référence que les lignes publiées. En contrepartie, toute lecture publique doit penser à filtrer sur ce champ, l'oubli est un défaut de confidentialité, ce qui justifie la couverture de tests dédiée." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="824" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c54" value="&lt;b&gt;ADR-014&lt;/b&gt;  ·  &lt;b&gt;Pagination par curseur opaque plutôt que par décalage&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d0ebff;strokeColor=#1c7ed6;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="832" y="626" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c55" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/02/26&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#1c7ed6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1432" y="630" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c56" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="664" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c57" value="Les listes de médias sont potentiellement longues et alimentées par défilement infini. La pagination par décalage se dégrade sur de gros volumes et produit des doublons quand des éléments s'insèrent." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="664" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c58" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="716" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c59" value="Paginer par curseur opaque encodant en base64url le couple « horodatage | identifiant » du dernier élément rendu, avec un tri composite stable." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="716" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c60" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="768" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c61" value="Pagination par décalage, écartée pour son coût croissant et son instabilité. Pagination par numéro de page, écartée pour les mêmes raisons." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="768" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c62" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="824" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c63" value="Coût de lecture constant quel que soit le rang, et absence de doublon ou d'omission lors d'insertions concurrentes. En contrepartie, il n'est pas possible de sauter directement à une page arbitraire, ce qui n'est pas un besoin du produit." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="824" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c64" value="&lt;b&gt;ADR-015&lt;/b&gt;  ·  &lt;b&gt;Site vitrine en export statique, servi par une interface publique dédiée&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d0ebff;strokeColor=#1c7ed6;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="40" y="880" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c65" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/03/03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#1c7ed6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="640" y="884" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c66" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="918" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c67" value="Le site vitrine et les profils publics doivent rester consultables sans serveur applicatif, pour le coût et pour la surface d'attaque. Cette contrainte est apparue tard et a pesé plus lourd que la plupart des exigences fonctionnelles." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="918" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c68" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="970" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c69" value="Produire le site en export statique Next.js, hébergé sur S3 derrière CloudFront, et exposer une interface publique dédiée (/api/public) consommée directement par le navigateur. Le profil public est servi par une route paramétrée par la chaîne de requête." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="970" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c70" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="1022" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c71" value="Rendu serveur du site public, écarté pour le coût d'exploitation d'un serveur supplémentaire. Génération statique par profil, écartée car elle exigerait de reconstruire et redéployer le site à chaque inscription." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="1022" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c72" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#1c7ed6;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="1078" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c73" value="Aucun serveur applicatif à maintenir pour la partie publique, coût de diffusion très faible et surface d'attaque réduite. En contrepartie, l'interface publique doit être conçue pour un appel non authentifié depuis un navigateur, débit limité, données strictement publiques, jamais d'adresse e-mail ni de média non publié." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="1078" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c74" value="&lt;b&gt;ADR-016&lt;/b&gt;  ·  &lt;b&gt;Observabilité auto-hébergée plutôt que service managé&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe8cc;strokeColor=#f76707;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="832" y="880" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c75" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/03/13&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#f76707;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1432" y="884" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c76" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="918" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c77" value="La question portait moins sur les outils que sur le modèle d'exploitation, au regard de la souveraineté des données et du coût récurrent." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="918" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c78" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="970" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c79" value="Auto-héberger Prometheus, Loki, Grafana et Alertmanager sur le nœud de périphérie, avec des configurations et des tableaux de bord provisionnés par le code." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="970" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c80" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="1022" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c81" value="Datadog ou New Relic, écartés pour un coût récurrent croissant avec le volume et une sortie des données hors Union européenne, en tension avec le RGPD. ELK/EFK, écarté pour une empreinte mémoire et disque disproportionnée au besoin, en contradiction avec l'exigence de sobriété." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="1022" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c82" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="1078" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c83" value="Souveraineté des données, coût de licence nul, observabilité elle-même reconstructible et versionnée. En contrepartie, l'exploitation est à la charge de l'équipe, la rétention est bornée par le disque, et la haute disponibilité reste à construire, inscrite au plan d'amélioration continue en priorité haute." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="1078" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c84" value="Sources : code et infrastructure du dépôt dropicture (apps/, infra/, .github/workflows/) · le statut « Acceptée » signifie que la décision est en vigueur. Une décision remplacée porterait le statut « Remplacée par ADR-xxx » et resterait au journal, car un journal dont on retire les entrées périmées perd sa raison d'être." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#adb5bd" parent="1" vertex="1">
          <mxGeometry x="40" y="1139" width="1574" height="18" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-4" name="Fiches ADR-017 à ADR-024">
    <mxGraphModel dx="888" dy="621" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="Annexe J, Fiches de décision ADR-017 à ADR-024 (BC1 C5 à C9)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#212529;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="26" width="1574" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="dropicture · format Contexte, Décision, Alternatives écartées avec le motif du rejet, Conséquences assumées y compris défavorables" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#868e96" parent="1" vertex="1">
          <mxGeometry x="40" y="56" width="1574" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="RNCP40573 · Expert en informatique et systèmes d'information, option DevOps · Amir Redjem · appelée en §11.1.1, §11.1.2 et §13.3.2 du mémoire" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9.5;fontColor=#adb5bd" parent="1" vertex="1">
          <mxGeometry x="40" y="78" width="1574" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;ADR-017&lt;/b&gt;  ·  &lt;b&gt;Estimation logicielle de la consommation énergétique&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe8cc;strokeColor=#f76707;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="40" y="118" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c5" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/03/17&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#f76707;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="640" y="122" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="156" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c7" value="L'éco-responsabilité n'est pilotable que si elle est mesurée. Or les compteurs matériels (RAPL) ne sont pas exposés sur des machines virtuelles louées, ce qui rend inopérants les outils de mesure directe." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="156" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="208" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c9" value="Intégrer à Prometheus un modèle d'estimation documenté, dérivé de l'utilisation processeur : nombre de cœurs × (1,5 W au repos + 4,5 W × taux d'utilisation), agrégé en puissance de cluster, énergie projetée sur 24 h et empreinte carbone estimée, avec un tableau de bord et une alerte dédiés." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="208" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="260" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c11" value="Ne rien mesurer, écarté, une éco-responsabilité non mesurée est une éco-responsabilité affichée. Attendre un déploiement sur matériel dédié, écarté car il repousse indéfiniment la mise en place de l'instrumentation." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="260" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="316" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c13" value="L'éco-responsabilité devient pilotable, avec un seuil d'alerte et un historique. La limite est assumée et documentée, il s'agit d'une estimation, non d'une mesure. Le passage à une mesure réelle par RAPL sur matériel dédié figure au plan d'amélioration continue." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="316" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;ADR-018&lt;/b&gt;  ·  &lt;b&gt;Le socket Docker n'est jamais exposé directement&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe3e3;strokeColor=#e03131;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="832" y="118" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c15" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/03/05&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#e03131;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1432" y="122" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="156" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c17" value="Traefik doit découvrir les services Swarm, ce qui suppose un accès à l'API Docker. Monter le socket dans un conteneur exposé à Internet équivaut à lui confier le contrôle du nœud." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="156" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="208" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c19" value="Interposer un mandataire (socket-proxy) sur un réseau overlay interne dédié, n'autorisant que les points de lecture strictement nécessaires (SWARM, SERVICES, TASKS, NETWORKS, NODES, INFO). Traefik interroge le mandataire en TCP, jamais le socket." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="208" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c20" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="260" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c21" value="Montage direct du socket dans Traefik, écarté pour l'élévation de privilège qu'il autorise en cas de compromission. Exposition de l'API Docker en TCP avec TLS mutuel, écartée pour la complexité de gestion des certificats au regard du gain." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="260" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c22" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="316" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c23" value="Une compromission de Traefik ne donne pas le contrôle du démon Docker. En contrepartie, un composant supplémentaire à maintenir, dont la moindre régression casse la découverte de services." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="316" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c24" value="&lt;b&gt;ADR-019&lt;/b&gt;  ·  &lt;b&gt;Certificat Cloudflare Origin CA et TLS strict de bout en bout&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe3e3;strokeColor=#e03131;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="40" y="372" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c25" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/03/06&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#e03131;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="640" y="376" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c26" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="410" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c27" value="Le trafic entre Cloudflare et l'origine doit être chiffré et authentifié, sans quoi la terminaison TLS en périphérie n'offrirait qu'une protection partielle." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="410" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c28" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="462" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c29" value="Générer la clé et la demande de signature sur le nœud manager, obtenir un certificat Cloudflare Origin CA (validité longue, couvrant le domaine et ses sous-domaines), le stocker en config Swarm et la clé en secret Swarm, et régler la zone en mode « full strict », TLS 1.2 minimum, redirection HTTPS systématique." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="462" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c30" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="514" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c31" value="Let's Encrypt avec renouvellement automatique, écarté ici parce que l'origine n'est joignable que depuis les plages Cloudflare, ce qui complique la validation HTTP-01, conservé comme alternative via DNS-01. Certificat auto-signé, incompatible avec le mode strict." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="514" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c32" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#e03131;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="570" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c33" value="Chiffrement et authentification de bout en bout, sans renouvellement fréquent à automatiser. En contrepartie, une config Swarm étant immuable, la rotation du certificat impose un changement de nom d'objet, procédure explicitement documentée et vérifiée par une assertion du playbook." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="570" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c34" value="&lt;b&gt;ADR-020&lt;/b&gt;  ·  &lt;b&gt;Images étiquetées par le SHA du dernier commit touchant le service&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe8cc;strokeColor=#f76707;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="832" y="372" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c35" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/03/10&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#f76707;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1432" y="376" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c36" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="410" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c37" value="Une étiquette mouvante (« latest ») rend impossible de savoir ce qui tourne réellement, et provoque des reconstructions inutiles quand un service n'a pas changé." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="410" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c38" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="462" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c39" value="Dériver, pour chaque service, l'étiquette d'image du SHA du dernier commit ayant touché son répertoire. Si l'image existe déjà dans le registre, la construction est sautée." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="462" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c40" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="514" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c41" value="Étiquetage par numéro de version sémantique, écarté pour la charge de gestion sur un mono-dépôt à livraison continue. Étiquetage par numéro de run, écarté car il ne permet pas de remonter au code." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="514" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c42" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="570" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c43" value="Ce qui tourne en production est rattachable sans ambiguïté à une ligne de code, et les constructions inutiles disparaissent. En contrepartie, l'historique du dépôt doit être complet lors du calcul, ce qui impose une extraction non superficielle dans le pipeline." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="570" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c44" value="&lt;b&gt;ADR-021&lt;/b&gt;  ·  &lt;b&gt;Portes de sécurité bloquantes et nomenclature logicielle par artefact&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe8cc;strokeColor=#f76707;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="40" y="626" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c45" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/03/11&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#f76707;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="640" y="630" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c46" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="664" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c47" value="Une vulnérabilité connue coûte beaucoup moins cher à traiter avant la mise en production qu'après. Encore faut-il que le contrôle empêche réellement le déploiement." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="664" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c48" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="716" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c49" value="Exécuter Trivy en portes bloquantes à trois endroits, dépendances et secrets du dépôt, configuration d'infrastructure (Terraform, Ansible, Dockerfile), puis image publiée. Seuils CRITICAL et HIGH, vulnérabilités sans correctif exclues. Produire une SBOM CycloneDX par image et publier les rapports SARIF dans GitHub Code Scanning." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="716" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c50" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="768" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c51" value="Analyses non bloquantes, écartées car un avertissement que rien n'arrête finit par être ignoré. Analyse à la seule construction, écartée car elle laisse passer les vulnérabilités du système de base de l'image." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="768" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c52" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="824" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c53" value="Aucun artefact vulnérable de manière connue et corrigeable n'atteint la production. Les exceptions sont centralisées dans un fichier dédié et doivent porter identifiant, motif et date de revue. En contrepartie, une vulnérabilité amont peut bloquer une livraison urgente : le dispositif d'exception est donc explicitement prévu et tracé." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="824" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c54" value="&lt;b&gt;ADR-022&lt;/b&gt;  ·  &lt;b&gt;Sauvegarde logique vers un stockage objet durci plutôt que réplication&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe8cc;strokeColor=#f76707;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="832" y="626" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c55" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/03/24&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#f76707;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1432" y="630" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c56" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="664" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c57" value="Il fallait distinguer deux protections souvent confondues, les données contre la perte, et l'infrastructure contre la destruction. Sauvegarder des serveurs qu'on sait recréer coûte cher pour rien, savoir recréer des serveurs ne remplace jamais une sauvegarde de base." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="664" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c58" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="716" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c59" value="Sauvegarder uniquement la base, par cliché logique compressé toutes les six heures, vérifié par empreinte SHA-256 et par contrôle de taille de l'objet déposé, vers un bucket S3 versionné, chiffré, à verrouillage d'objet et cycle de vie (quotidiennes 35 jours, mensuelles 365 jours en archivage froid). L'infrastructure, elle, est reconstruite par le code." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="716" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c60" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="768" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c61" value="Réplication en continu vers un second serveur, écartée pour le coût d'un nœud supplémentaire au regard d'un objectif de point de reprise de six heures jugé acceptable. Instantanés de volume, écartés car ils sauvegardent la machine plutôt que la donnée et se restaurent moins finement." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="768" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c62" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#f76707;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="824" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c63" value="Coût de stockage maîtrisé et protection contre l'altération volontaire, y compris par rançongiciel. L'objectif de point de reprise est de six heures au plus, assumé. Un exercice de restauration périodique en conditions réelles reste à formaliser, c'est la limite explicite du dispositif." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="824" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c64" value="&lt;b&gt;ADR-023&lt;/b&gt;  ·  &lt;b&gt;Index partiels comme levier d'éco-conception&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#c3fae8;strokeColor=#099268;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="40" y="880" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c65" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/02/25&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#099268;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="640" y="884" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c66" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="918" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c67" value="Les brouillons privés sont majoritaires en volume. Un index complet sur la visibilité indexerait massivement des lignes qui ne seront jamais lues par le chemin public." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="918" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c68" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="970" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c69" value="Restreindre les index aux lignes réellement concernées, l'index du fil public ne référence que les médias publiés de rôle « contenu », et l'unicité de la clé d'API ne s'applique qu'aux comptes qui en possèdent une." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="970" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c70" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="1022" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c71" value="Index complets, écartés pour l'empreinte de stockage et le coût de maintenance à l'écriture. Absence d'index avec tri applicatif, écartée pour la dégradation des lectures les plus fréquentes." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="1022" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c72" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="1078" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c73" value="Empreinte de stockage réduite et lectures publiques accélérées, performance et sobriété vont ici dans le même sens. En contrepartie, le planificateur n'utilise l'index que si la requête reprend exactement le prédicat partiel, ce qui contraint la formulation des requêtes." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="208" y="1078" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c74" value="&lt;b&gt;ADR-024&lt;/b&gt;  ·  &lt;b&gt;La suppression en cascade est le socle du droit à l'effacement&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#c3fae8;strokeColor=#099268;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=12" parent="1" vertex="1">
          <mxGeometry x="832" y="880" width="782" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c75" value="&lt;font style='font-size:9px'&gt;Statut Acceptée  ·  2025/02/25&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#099268;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1432" y="884" width="176" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c76" value="&lt;b&gt;Contexte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="918" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c77" value="Le droit à l'effacement ne peut pas reposer sur une procédure applicative qu'un oubli de code suffirait à rendre incomplète." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="918" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c78" value="&lt;b&gt;Décision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="970" width="168" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c79" value="Porter la sémantique d'effacement par les contraintes de la base, suppression en cascade d'un compte vers ses médias, albums, placements et liens d'abonnement, références douces (avatar, couverture) ramenées à NULL plutôt que bloquantes. Le service supprime en parallèle les objets du stockage." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="970" width="614" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c80" value="&lt;b&gt;Alternatives écartées&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="1022" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c81" value="Suppression logique par indicateur, écartée car elle conserve les données et contredit l'esprit du règlement. Suppression applicative sans contrainte en base, écartée pour le risque d'oubli lors de l'ajout d'une future table." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="1022" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c82" value="&lt;b&gt;Conséquences&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#099268;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="1078" width="168" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c83" value="Supprimer un compte fait mécaniquement disparaître l'ensemble de ses données, en base comme sur le stockage objet. La conservation d'un pointeur n'empêche jamais un effacement. En contrepartie, toute nouvelle table référençant un compte devra déclarer explicitement son comportement de suppression." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1000" y="1078" width="614" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c84" value="Sources : code et infrastructure du dépôt dropicture (apps/, infra/, .github/workflows/) · le statut « Acceptée » signifie que la décision est en vigueur. Une décision remplacée porterait le statut « Remplacée par ADR-xxx » et resterait au journal, car un journal dont on retire les entrées périmées perd sa raison d'être." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#adb5bd" parent="1" vertex="1">
          <mxGeometry x="40" y="1139" width="1574" height="18" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
