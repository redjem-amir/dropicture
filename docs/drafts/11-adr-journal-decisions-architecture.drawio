        <mxCell id="c1" value="Annexe J, Journal des décisions d'architecture (ADR), alternatives écartées et conséquences assumées (BC1 C5 à C9)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#212529;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="26" width="1574" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="dropicture · vingt-quatre décisions structurantes au format Contexte, Décision, Alternatives écartées, Conséquences · toutes en vigueur et effectivement appliquées dans le dépôt" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#868e96" parent="1" vertex="1">
          <mxGeometry x="40" y="56" width="1574" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="RNCP40573 · Expert en informatique et systèmes d'information, option DevOps · Amir Redjem · appelée en §11.1.1, §11.1.2 et §13.3.2 du mémoire" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9.5;fontColor=#adb5bd" parent="1" vertex="1">
          <mxGeometry x="40" y="78" width="1574" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="Un journal de décisions d'architecture consigne le raisonnement, pas seulement son résultat. Chaque entrée énonce le contexte qui a rendu la décision nécessaire, la décision elle-même, les alternatives réellement examinées avec le motif de leur rejet, et les conséquences assumées, y compris quand elles sont défavorables. C'est cette forme qui rend une décision réexaminable plus tard, y compris par quelqu'un d'autre, et qui évite qu'un choix daté ne se transforme silencieusement en contrainte subie." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="112" width="1574" height="44" as="geometry"/>
        </mxCell>
