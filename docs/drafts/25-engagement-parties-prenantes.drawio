          <mxGeometry x="40" y="756" width="46" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="c46" value="&lt;b&gt;Fournisseurs cloud (Hetzner, Cloudflare, AWS)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="86" y="756" width="232" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="c47" value="&lt;b&gt;Neutre&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f1f3f5;strokeColor=#adb5bd;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="318" y="756" width="92" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="c48" value="Veille sur les conditions de service et les évolutions de licence, deux fois observées dans le secteur. Trajectoires de repli documentées et à syntaxe compatible pour limiter le verrouillage (cf. Annexe J, ADR-006 et ADR-007)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="410" y="756" width="856" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="c49" value="Veille technologique · pages de statut des fournisseurs · alertes budgétaires" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1266" y="756" width="348" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="c50" value="2.  Techniques de gestion de la motivation et capitalisation des compétences" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#1c7ed6;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="858" width="700" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c51" value="RECONNAISSANCE DU TRAVAIL INVISIBLE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#2f9e44" parent="1" vertex="1">
          <mxGeometry x="40" y="884" width="508" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="c52" value="La revue d'itération se clôture par une démonstration de ce qui a été terminé, y compris sur les lots non fonctionnels. Rendre visible une chaîne de livraison ou une règle d'alerte est la seule façon d'en faire reconnaître la valeur." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="54" y="914" width="480" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="c53" value="PASSATION DES COMPÉTENCES" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e5dbff;strokeColor=#7048e8;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#7048e8" parent="1" vertex="1">
          <mxGeometry x="573" y="884" width="508" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="c54" value="Programmation en binôme sur les points délicats, journal des décisions d'architecture, runbooks d'exploitation écrits pour un lecteur qui découvre. Un changement de membre d'équipe ne suppose aucune transmission orale." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="587" y="914" width="480" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="c55" value="CÉLÉBRATION DES JALONS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe8cc;strokeColor=#f76707;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#f76707" parent="1" vertex="1">
          <mxGeometry x="1106" y="884" width="508" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="c56" value="Les cinq jalons M1 à M5 portent un critère de franchissement explicite. Le passage est annoncé et commenté, ce qui donne un rythme au projet et matérialise l'avancement autrement que par un pourcentage." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1120" y="914" width="480" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="c57" value="Sources : mémoire §13.4.2 (engagement), §13.3.1 (encadrement et motivation), §13.4.1 (plan de communication) · Annexe T (outils collaboratifs et tableau de bord) · Annexe N (jalons M1 à M5)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#adb5bd" parent="1" vertex="1">
          <mxGeometry x="40" y="1139" width="1574" height="18" as="geometry"/>
        </mxCell>
