        <mxCell id="c50" value="Disposition retenue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#dee2e6;strokeColor=#495057;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="308" y="586" width="962" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c51" value="Où elle s'applique" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#dee2e6;strokeColor=#495057;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="1270" y="586" width="344" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c52" value="Déficience visuelle" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="40" y="612" width="268" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="c53" value="Contrastes conformes aux critères WCAG 2.2 dans les interfaces et dans les supports, structures de titres correctes, contenus lisibles par lecteur d'écran. Aucune information portée par la seule couleur, les statuts portent aussi un libellé." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="308" y="612" width="962" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="c54" value="Interfaces du produit · dossier technique · annexes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="1270" y="612" width="344" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="c55" value="Déficience auditive" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="40" y="660" width="268" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="c56" value="Comptes rendus écrits systématiques des points d'avancement et des revues. Aucune information de pilotage n'est transmise uniquement à l'oral." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="308" y="660" width="962" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="c57" value="Comités de jalon · revues d'itération · rétrospectives" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
