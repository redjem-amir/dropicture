        <mxCell id="c38" value="Confrontation systématique des arbitrages aux contraintes observées en production réelle. Les limites d'échelle sont documentées plutôt que passées sous silence." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
