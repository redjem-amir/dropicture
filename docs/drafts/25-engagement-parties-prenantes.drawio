          <mxGeometry x="40" y="708" width="268" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="c59" value="Navigation entièrement opérable au clavier, zones d'interaction dimensionnées selon les critères de cible. Aucune interaction n'exige un geste précis ou maintenu." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
