        <mxCell id="c42" value="&lt;b&gt;Favorable&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#d0ebff;strokeColor=#1c7ed6;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="318" y="672" width="92" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="c43" value="Validation des maquettes basse fidélité avant développement (cf. Annexe F.1). Discuter d'un agencement d'écran coûte quelques minutes sur une maquette et quelques jours sur du code. Formalisation d'un canal de retour et d'un rythme de restitution." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="410" y="672" width="856" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="c44" value="Session de test guidée · formulaire de retour · comptes rendus écrits" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1266" y="672" width="348" height="84" as="geometry"/>
        </mxCell>
