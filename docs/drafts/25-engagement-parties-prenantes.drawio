        <mxCell id="c42" value="&lt;b&gt;Gérer de près&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1040" y="168" width="148" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="c43" value="PP1 et PP2 cumulent pouvoir de décision et intérêt élevé. PP4 les rejoint sur le périmètre de conformité. Association aux arbitrages, information dense et anticipée." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1192" y="168" width="422" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="c44" value="&lt;b&gt;Tenir informé&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#fff3bf;strokeColor=#f59f00;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1040" y="254" width="148" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="c45" value="PP5 porte un intérêt fort pour un pouvoir moyen sur les choix techniques, ce qui appelle une information régulière et structurée. PP3, PP6 et PP8 relèvent du même traitement." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1192" y="254" width="422" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="c46" value="&lt;b&gt;Surveiller&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f1f3f5;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1040" y="340" width="148" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="c47" value="PP7 dispose aujourd'hui de peu de pouvoir et d'un intérêt moyen. L'action de la page 2 vise précisément à faire monter cet intérêt en outillant un canal de retour." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1192" y="340" width="422" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="c48" value="3.  Accessibilité de la participation, référentiels WCAG 2.2 (W3C) et RGAA 4 (DINUM)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#1c7ed6;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="560" width="700" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c49" value="Situation prise en compte" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#dee2e6;strokeColor=#495057;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="586" width="268" height="26" as="geometry"/>
