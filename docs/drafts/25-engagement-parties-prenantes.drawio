        <mxCell id="c13" value="Reporting synthétique au franchissement de chaque jalon, adossé aux tableaux de bord plutôt qu'à des documents produits à la main. Association aux arbitrages de périmètre par l'impact sur le chemin critique et sur le budget." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
