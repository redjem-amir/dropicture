        <mxCell id="c62" value="Formulations courtes et explicites, une idée par paragraphe, messages d'erreur porteurs d'un code stable et d'une explication. Documentation structurée et indexée." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
