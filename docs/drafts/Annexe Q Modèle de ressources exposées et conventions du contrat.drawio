                <mxCell id="c74" value="Données d&#39;inscription et règles de mot de passe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
                    <mxGeometry x="500" y="644" width="540" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="c75" value="2.  Conventions du contrat" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#1c7ed6;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="1070" y="202" width="560" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="c76" value="ERREURS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe3e3;strokeColor=#e03131;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#e03131" parent="1" vertex="1">
                    <mxGeometry x="1070" y="228" width="544" height="108" as="geometry"/>
                </mxCell>
                <mxCell id="c77" value="Les erreurs renvoient un corps portant un code stable, par exemple INVALID_CREDENTIALS, ACCOUNT_NOT_FOUND ou MEDIA_NOT_FOUND. Un média appartenant à un tiers renvoie MEDIA_NOT_FOUND, jamais un code distinguant l&#39;inexistence de l&#39;interdiction, afin de ne rien révéler sur l&#39;existence d&#39;une ressource." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="1084" y="258" width="516" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c78" value="PAGINATION PAR CURSEUR OPAQUE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d0ebff;strokeColor=#1c7ed6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#1c7ed6" parent="1" vertex="1">
                    <mxGeometry x="1070" y="346" width="544" height="108" as="geometry"/>
                </mxCell>
                <mxCell id="c79" value="Le curseur encode en base64url le couple horodatage et identifiant du dernier élément rendu. Coût de lecture constant quel que soit le rang, et aucun doublon lorsqu&#39;un média est publié pendant la navigation (cf. Annexe J, ADR-014)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="1084" y="376" width="516" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c80" value="LIMITATION DE DÉBIT" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe8cc;strokeColor=#f76707;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#f76707" parent="1" vertex="1">
                    <mxGeometry x="1070" y="464" width="544" height="108" as="geometry"/>
                </mxCell>
                <mxCell id="c81" value="Le débit est limité par adresse et par route, avec un stockage Redis. Les en-têtes de quota accompagnent chaque réponse. Dix connexions par minute, cinq inscriptions par heure." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="1084" y="494" width="516" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c82" value="OPÉRATIONS DE MASSE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e5dbff;strokeColor=#7048e8;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#7048e8" parent="1" vertex="1">
                    <mxGeometry x="1070" y="582" width="544" height="108" as="geometry"/>
                </mxCell>
                <mxCell id="c83" value="Une opération de masse renvoie un compte rendu par élément, réussites d&#39;un côté, échecs qualifiés de l&#39;autre. Le lot est borné à 200 identifiants et l&#39;opération est idempotente." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="1084" y="612" width="516" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c84" value="PLAFOND DE CORPS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#c3fae8;strokeColor=#099268;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#099268" parent="1" vertex="1">
                    <mxGeometry x="1070" y="700" width="544" height="108" as="geometry"/>
                </mxCell>
                <mxCell id="c85" value="Le corps JSON est plafonné à 100 Ko. Les téléversements binaires ne passent pas par cette limite, ils sont pilotés en flux vers le stockage objet sans mise en mémoire (cf. Annexe J, ADR-012)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="1084" y="730" width="516" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="c86" value="CRITÈRES DU RÉFÉRENTIEL COUVERTS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ebfbee;strokeColor=#2f9e44;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#2f9e44" parent="1" vertex="1">
