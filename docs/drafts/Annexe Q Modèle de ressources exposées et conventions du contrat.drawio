                <mxCell id="c4" value="PRINCIPE FONDATEUR DU CONTRAT" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e9fac8;strokeColor=#74b816;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#74b816" parent="1" vertex="1">
                    <mxGeometry x="40" y="112" width="1574" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="c5" value="Tout média déposé est &lt;b&gt;privé par défaut&lt;/b&gt;. Seule une action explicite de son propriétaire le rend public, et cette action reste révocable à tout instant. Techniquement, le champ de publication du média vaut NULL à l&#39;écriture, la publication ne fait que dater ce champ (cf. Annexe J, ADR-013). Aucune opération du contrat ne permet de contourner cette règle." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="54" y="142" width="1546" height="38" as="geometry"/>
                </mxCell>
