                <mxCell id="n40" value="Object Lock GOVERNANCE, une sauvegarde ne peut être&lt;br&gt;ni altérée ni supprimée avant l&#39;échéance" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
