        <mxCell id="c1" value="Annexe E bis, Script SQL de création des tables, contraintes d'intégrité et index (BC3 C21, BC2 C13)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#212529;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="26" width="1574" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="dropicture · PostgreSQL 18 · 5 relations, 8 contraintes d'intégrité référentielle, 9 index dont 2 partiels · transcription fidèle de la migration appliquée en production" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#868e96" parent="1" vertex="1">
          <mxGeometry x="40" y="56" width="1574" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="RNCP40573 · Expert en informatique et systèmes d'information, option DevOps · Amir Redjem · appelée en §14.1.4 du mémoire · transcription de la migration 1784545615923-init.ts" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9.5;fontColor=#adb5bd" parent="1" vertex="1">
          <mxGeometry x="40" y="78" width="1574" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="Ce script est la transcription du modèle logique de données (cf. Annexe E) en instructions exécutables. Il n'a pas été écrit pour l'annexe, il reprend la migration effectivement appliquée en production, apps/saas/backend/src/db/migrations/1784545615923-init.ts, à laquelle ont été ajoutés les commentaires et la mise en forme. Les noms de contraintes générés automatiquement par l'outil de migration ont été remplacés par des noms lisibles, sans autre modification." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="112" width="1574" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="c5" value="1.  Ce que le schéma impose au niveau de la base, et non au niveau du code" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#1c7ed6;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="166" width="900" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c6" value="Mécanisme" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#dee2e6;strokeColor=#495057;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="192" width="280" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c7" value="Où il s'applique" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#dee2e6;strokeColor=#495057;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="320" y="192" width="330" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c8" value="Ce qu'il garantit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#dee2e6;strokeColor=#495057;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="650" y="192" width="470" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c9" value="Pourquoi au niveau de la base et non du code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#dee2e6;strokeColor=#495057;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="1120" y="192" width="494" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c10" value="Suppression en cascade" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="40" y="218" width="280" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c11" value="media, albums, placements et follows vers accounts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="320" y="218" width="330" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c12" value="La suppression d'un compte efface l'ensemble de ses données liées en une seule transaction" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="650" y="218" width="470" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c13" value="Le droit à l'effacement ne doit pas dépendre d'un chemin applicatif qui pourrait être contourné" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="1120" y="218" width="494" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c14" value="Mise à NULL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="40" y="264" width="280" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c15" value="avatarMediaId et coverMediaId" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="320" y="264" width="330" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c16" value="Un média peut toujours être supprimé, même s'il sert d'avatar ou de couverture" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="650" y="264" width="470" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c17" value="Un pointeur d'affichage ne doit jamais empêcher un effacement légitime" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="1120" y="264" width="494" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c18" value="Clé primaire composite" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
