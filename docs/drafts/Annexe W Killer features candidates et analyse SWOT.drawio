        </mxCell>
        <mxCell id="c29" value="5.  Analyse SWOT de chaque killer feature" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#1c7ed6;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="264" width="1574" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c30" value="KF1  Privé par défaut, publication réversible par lot" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f1f3f5;strokeColor=#495057;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="288" width="511.333" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c31" value="&lt;b&gt;&lt;font color=&quot;#2f9e44&quot;&gt;Forces&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Répond à une inquiétude réelle sur la maîtrise de la visibilité. Règle simple, énonçable en une phrase. Coût faible, la visibilité étant un horodatage sur la ligne." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=1.6;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="318" width="250.667" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="c32" value="&lt;b&gt;&lt;font color=&quot;#e03131&quot;&gt;Faiblesses&lt;/font&gt;&lt;/b&gt;&lt;br&gt;N'apporte rien de visible tant que rien n'est déposé. Difficile à démontrer en capture, l'absence de fuite ne se voit pas." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe3e3;strokeColor=#e03131;strokeWidth=1.6;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="300.667" y="318" width="250.667" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="c33" value="&lt;b&gt;&lt;font color=&quot;#1c7ed6&quot;&gt;Opportunités&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Aligne le produit sur le RGPD et la minimisation. Discours produit clair face à des modèles de visibilité confus." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d0ebff;strokeColor=#1c7ed6;strokeWidth=1.6;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="422" width="250.667" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="c34" value="&lt;b&gt;&lt;font color=&quot;#f76707&quot;&gt;Menaces&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Un concurrent peut annoncer la promesse sans la tenir. Une seule fuite la détruit." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe8cc;strokeColor=#f76707;strokeWidth=1.6;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="300.667" y="422" width="250.667" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="c35" value="KF2  Profil public en page statique servie par CDN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f1f3f5;strokeColor=#495057;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="571.333" y="288" width="511.333" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c36" value="&lt;b&gt;&lt;font color=&quot;#2f9e44&quot;&gt;Forces&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Coût de diffusion quasi nul, indépendant du trafic. Affichage très court. Aucune surface d'exécution exposée." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=1.6;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="571.333" y="318" width="250.667" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="c37" value="&lt;b&gt;&lt;font color=&quot;#e03131&quot;&gt;Faiblesses&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Contraint l'adressage à /u/?u=pseudo, moins lisible. Fraîcheur dépendante de l'invalidation du cache." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe3e3;strokeColor=#e03131;strokeWidth=1.6;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="318" width="250.667" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="c38" value="&lt;b&gt;&lt;font color=&quot;#1c7ed6&quot;&gt;Opportunités&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Ouvre l'indexation par les moteurs, acquisition sans coût publicitaire. Compétence d'architecture rare à cette échelle." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d0ebff;strokeColor=#1c7ed6;strokeWidth=1.6;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="571.333" y="422" width="250.667" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="c39" value="&lt;b&gt;&lt;font color=&quot;#f76707&quot;&gt;Menaces&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Une évolution de l'export statique peut casser la chaîne. Le compromis d'adressage peut être jugé sévèrement." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe8cc;strokeColor=#f76707;strokeWidth=1.6;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="832" y="422" width="250.667" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="c40" value="KF3  Clé d'API personnelle, rotative et révocable" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f1f3f5;strokeColor=#495057;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="1102.67" y="288" width="511.333" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c41" value="&lt;b&gt;&lt;font color=&quot;#2f9e44&quot;&gt;Forces&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Réversibilité démontrable, l'utilisateur sort ses données lui-même. Faible coût, l'ossature d'authentification existant déjà." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=1.6;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1102.67" y="318" width="250.667" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="c42" value="&lt;b&gt;&lt;font color=&quot;#e03131&quot;&gt;Faiblesses&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Concerne une minorité d'utilisateurs. Élargit la surface d'attaque avec un second chemin d'authentification." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe3e3;strokeColor=#e03131;strokeWidth=1.6;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1363.33" y="318" width="250.667" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="c43" value="&lt;b&gt;&lt;font color=&quot;#1c7ed6&quot;&gt;Opportunités&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Répond au règlement sur les données et à la portabilité. Ouvre un usage automatisé et des intégrations tierces." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d0ebff;strokeColor=#1c7ed6;strokeWidth=1.6;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1102.67" y="422" width="250.667" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="c44" value="&lt;b&gt;&lt;font color=&quot;#f76707&quot;&gt;Menaces&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Une clé fuitée donne un accès durable sans révocation immédiate. Impose une limitation de débit dédiée." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe8cc;strokeColor=#f76707;strokeWidth=1.6;fontFamily=Helvetica;fontSize=8.5;fontColor=#212529;align=left;verticalAlign=top;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1363.33" y="422" width="250.667" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="c45" value="Sources, mémoire §11.2.1 (fonctionnalités requises) · Annexe E, Annexe Q, Annexe I.2 · page 2 sur 3" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#adb5bd" parent="1" vertex="1">
          <mxGeometry x="40" y="1139" width="1574" height="18" as="geometry"/>
        </mxCell>
      </root>
