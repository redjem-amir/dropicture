        <mxCell id="c1" value="Annexe Z, Scénarios de test détaillés couvrant les fonctionnalités critiques (BC3 C26)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#212529;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="26" width="1574" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="dropicture · vingt-quatre scénarios, chacun rattaché à la user story qu'il vérifie (cf. Annexe X) et au risque qu'il couvre (cf. Annexe O)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#868e96" parent="1" vertex="1">
