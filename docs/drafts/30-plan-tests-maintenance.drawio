        <mxCell id="c1" value="Annexe Z, Plan de tests, scénarios de test complets couvrant les fonctionnalités critiques (BC2 C13, BC3 C26)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#212529;fontStyle=1" parent="1" vertex="1">
