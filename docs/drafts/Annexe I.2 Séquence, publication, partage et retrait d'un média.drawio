                <mxCell id="n35" value="&lt;b&gt;Idempotence.&lt;/b&gt; COALESCE préserve la date de publication d&#39;origine, republier un média ne réécrit pas son historique. Dépublier puis republier reste une opération sûre." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d0ebff;strokeColor=#1c7ed6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8" parent="1" vertex="1">
                    <mxGeometry x="60" y="868" width="500" height="82" as="geometry"/>
                </mxCell>
                <mxCell id="n36" value="&lt;b&gt;Contrôle d&#39;appartenance.&lt;/b&gt; Chaque requête est bornée par &lt;i&gt;ownerId = :owner&lt;/i&gt;, un membre ne peut agir que sur ses propres médias, et l&#39;échec est restitué média par média avec son code." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffe3e3;strokeColor=#e03131;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8" parent="1" vertex="1">
                    <mxGeometry x="580" y="868" width="500" height="82" as="geometry"/>
                </mxCell>
                <mxCell id="n37" value="&lt;b&gt;Partage sans duplication.&lt;/b&gt; Le partage est un basculement d&#39;état, pas une copie. La galerie publique lit un index partiel qui ne référence que les lignes publiées." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e9fac8;strokeColor=#74b816;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8" parent="1" vertex="1">
                    <mxGeometry x="1100" y="868" width="500" height="82" as="geometry"/>
                </mxCell>
