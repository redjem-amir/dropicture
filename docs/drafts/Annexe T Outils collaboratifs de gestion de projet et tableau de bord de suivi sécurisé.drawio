        </mxCell>
        <mxCell id="c110" value="&lt;b&gt;59 cartes au total&lt;/b&gt;  ·  Avancement de 56 % en nombre de cartes terminées. Le nombre de cartes par colonne constitue à lui seul un indicateur de pilotage. Une colonne « In progress » qui gonfle signale un travail commencé et non terminé, c'est-à-dire de la valeur immobilisée. La colonne « In review » est la plus révélatrice, une accumulation y traduit un goulot d'étranglement sur la revue, pas sur la production." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e9fac8;strokeColor=#74b816;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="40" y="872" width="1574" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c111" value="3.  Limite de travail en cours et lecture de l'avancement" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#1c7ed6;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="920" width="900" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c112" value="&lt;b&gt;59&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;cartes au total&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f1f3f5;strokeColor=#adb5bd;strokeWidth=2;fontFamily=Helvetica;fontSize=22;fontColor=#adb5bd;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="40" y="946" width="300" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="c113" value="&lt;b&gt;33&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;cartes terminées&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=2;fontFamily=Helvetica;fontSize=22;fontColor=#2f9e44;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="360" y="946" width="300" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="c114" value="&lt;b&gt;56 %&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;d'avancement en nombre de cartes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d0ebff;strokeColor=#1c7ed6;strokeWidth=2;fontFamily=Helvetica;fontSize=22;fontColor=#1c7ed6;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
