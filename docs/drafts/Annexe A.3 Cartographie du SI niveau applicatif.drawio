                    <mxGeometry x="1282" y="658" width="296" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="n66" value="&lt;b&gt;Aucun média n&#39;est bufferisé en mémoire.&lt;/b&gt; Le corps de la requête est piloté en flux vers S3 en multipart (tranches de 5 Mo), un transformateur comptant les octets et interrompant l&#39;envoi au-delà du seuil (8 Mo image, 100 Mo vidéo)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" vertex="1" parent="1">
                    <mxGeometry x="1282" y="722" width="296" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="n67" value="La configuration du CDN n&#39;est jamais codée en dur, le backend la lit dans SSM au démarrage et refuse de démarrer si elle est incomplète." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" vertex="1" parent="1">
