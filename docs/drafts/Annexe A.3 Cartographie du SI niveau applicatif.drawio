                <mxCell id="n41" value="Sonde &lt;b&gt;GET /health&lt;/b&gt;, répond avant tout intergiciel Nest, consommée par Traefik (healthcheck de service) et par Docker Swarm (healthcheck de conteneur)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" vertex="1" parent="1">
