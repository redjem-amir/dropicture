        <mxCell id="c84" value="Aucun canal structuré de remontée n'est aujourd'hui outillé dans le produit. Les retours arrivent de façon informelle et se perdent." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
