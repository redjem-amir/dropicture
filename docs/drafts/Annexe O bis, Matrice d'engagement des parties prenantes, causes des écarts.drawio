        <mxCell id="c92" value="&lt;b&gt;Neutre&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f1f3f5;strokeColor=#adb5bd;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="822" y="850" width="92" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="c93" value="&lt;b&gt;0&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="914" y="850" width="48" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="c94" value="Aucun écart à traiter. La relation est contractuelle et l'influence réciproque est nulle, seule la dépendance est réelle." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="962" y="850" width="652" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="c95" value="2.  Échelle d'engagement retenue" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#1c7ed6;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="962" width="700" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c96" value="&lt;b&gt;Hostile&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffe3e3;strokeColor=#e03131;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="40" y="988" width="116" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c97" value="S'oppose activement au projet ou à ses arbitrages. Aucune partie prenante dans cette position." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="158" y="988" width="264" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c98" value="&lt;b&gt;Neutre&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f1f3f5;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="434" y="988" width="116" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c99" value="Ni opposition ni contribution. Présent au dispositif sans l'alimenter." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="552" y="988" width="264" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c100" value="&lt;b&gt;Favorable&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#d0ebff;strokeColor=#1c7ed6;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="828" y="988" width="116" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c101" value="Adhère aux objectifs et répond aux sollicitations, sans initiative propre." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="946" y="988" width="264" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c102" value="&lt;b&gt;Moteur&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1222" y="988" width="116" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c103" value="Porte le projet, anticipe les besoins et alimente le dispositif sans y être invité." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1340" y="988" width="264" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c104" value="Cinq parties prenantes sur huit portent un écart de un niveau entre position actuelle et position cible. Aucune n'est hostile, ce qui déplace l'effort de la conviction vers l'outillage de la contribution." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e9fac8;strokeColor=#74b816;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="40" y="1030" width="1574" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="c105" value="Sources, mémoire §13.4.2 (gestion de l'engagement des parties prenantes) · Annexe L bis (matrice RACI) · Annexe F.1 (maquettes soumises aux utilisateurs bêta) · Annexe J (décisions ADR-006 et ADR-007, dépendance fournisseurs)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#adb5bd" parent="1" vertex="1">
          <mxGeometry x="40" y="1139" width="1574" height="18" as="geometry"/>
