                <mxCell id="c174" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=center;verticalAlign=middle;spacing=3;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="516" y="1064" width="52" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="c175" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=center;verticalAlign=middle;spacing=3;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="568" y="1064" width="52" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="c176" value="8 lots" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=center;verticalAlign=middle;spacing=3;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="620" y="1064" width="62" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="c177" value="Aucun lot sans décideur, aucun lot à deux décideurs, quatre acteurs porteurs d&#39;au moins un A." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="682" y="1064" width="932" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="c178" value="Sources : mémoire §13.1.2 (allocation des ressources), §13.3 (management de l&#39;équipe) et §13.4.1 (plan de communication) · Annexe L (structure de découpage, huit lots) · Annexe M (PERT, chemin critique) · Annexe O bis (engagement des parties prenantes)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#adb5bd" parent="1" vertex="1">
                    <mxGeometry x="40" y="1139" width="1574" height="18" as="geometry"/>
