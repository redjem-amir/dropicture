        </mxCell>
        <mxCell id="c23" value="follows" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="320" y="356" width="330" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c24" value="Un compte ne peut pas s'abonner à lui-même" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="650" y="356" width="470" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c25" value="Une règle métier vérifiée uniquement dans le code finit par être contournée" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="1120" y="356" width="494" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c26" value="Index unique partiel" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="40" y="402" width="280" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c27" value="apiKey, uniquement quand la valeur n'est pas NULL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="320" y="402" width="330" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c28" value="Unicité des clés d'API sans interdire aux comptes sans clé de coexister" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="650" y="402" width="470" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c29" value="Un index unique classique refuserait plusieurs valeurs NULL sur certains moteurs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="1120" y="402" width="494" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c30" value="Index partiel de publication" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="40" y="448" width="280" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c31" value="publishedAt, uniquement pour les médias publiés de rôle content" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="320" y="448" width="330" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c32" value="Le fil public n'indexe que les lignes réellement visibles" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="650" y="448" width="470" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c33" value="Les brouillons privés étant majoritaires, l'index occupe moins d'espace et se parcourt plus vite" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="1120" y="448" width="494" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c34" value="Le dernier mécanisme relève directement de l'éco-conception. Indexer l'intégralité de la table reviendrait à maintenir une structure dont la majeure partie ne serait jamais lue. La sobriété se joue là, dans une clause WHERE, plus que dans le choix d'un hébergeur." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e9fac8;strokeColor=#74b816;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="40" y="520" width="1574" height="32" as="geometry"/>
        </mxCell>
