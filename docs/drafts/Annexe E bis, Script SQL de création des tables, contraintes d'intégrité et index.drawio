        </mxCell>
        <mxCell id="c19" value="placements et follows" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="320" y="310" width="330" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c20" value="Aucun identifiant technique inutile, la clé est le couple métier" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="650" y="310" width="470" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c21" value="Allège le stockage et l'indexation, et interdit structurellement le doublon" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
          <mxGeometry x="1120" y="310" width="494" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c22" value="Contrainte CHECK" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
