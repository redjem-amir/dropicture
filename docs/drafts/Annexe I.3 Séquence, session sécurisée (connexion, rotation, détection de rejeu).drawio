                <mxCell id="m46" value="UPDATE accounts SET tokenVersion = tokenVersion + 1&lt;br/&gt;&lt;b&gt;→ toutes les sessions du compte sont invalidées&lt;/b&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#e03131;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#e03131;labelBackgroundColor=#ffffff;align=center;rounded=0" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="941" y="1110" as="sourcePoint"/>
                        <mxPoint x="1457" y="1110" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="m47" value="401  ·  reconnexion exigée" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;strokeColor=#e03131;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#e03131;labelBackgroundColor=#ffffff;align=center;rounded=0;dashed=1;dashPattern=6 4" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="941" y="1136" as="sourcePoint"/>
                        <mxPoint x="167" y="1136" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="n48" value="&lt;b&gt;Cookie opaque.&lt;/b&gt; Le navigateur ne détient aucune donnée exploitable, ni identité, ni rôle, ni date d&#39;expiration. Toute la vérité vit côté serveur, dans Redis." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e5dbff;strokeColor=#7048e8;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8" parent="1" vertex="1">
                    <mxGeometry x="60" y="1186" width="500" height="82" as="geometry"/>
                </mxCell>
                <mxCell id="n49" value="&lt;b&gt;Verrou de rotation.&lt;/b&gt; Deux onglets qui rafraîchissent en même temps ne produisent qu&#39;une rotation, le second attend et récupère le cookie déjà émis pendant la fenêtre de grâce." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#c3fae8;strokeColor=#099268;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8" parent="1" vertex="1">
                    <mxGeometry x="580" y="1186" width="500" height="82" as="geometry"/>
                </mxCell>
                <mxCell id="n50" value="&lt;b&gt;Changement de mot de passe.&lt;/b&gt; Il incrémente &lt;i&gt;tokenVersion&lt;/i&gt;, ce qui révoque instantanément toutes les sessions ouvertes, puis réémet une session pour l&#39;appareil courant." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffe3e3;strokeColor=#e03131;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8" parent="1" vertex="1">
                    <mxGeometry x="1100" y="1186" width="500" height="82" as="geometry"/>
                </mxCell>
                <mxCell id="n51" value="Sources, services/auth.service.ts · controllers/auth.controller.ts · guards/access.strategy.ts · apps/saas/frontend/src/proxy.ts" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#adb5bd" parent="1" vertex="1">
                    <mxGeometry x="60" y="1292" width="1000" height="18" as="geometry"/>
