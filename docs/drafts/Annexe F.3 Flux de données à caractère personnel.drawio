                <mxCell id="n69" value="Dernière connexion" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f3d9fa;strokeColor=#ae3ec9;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;fontStyle=1;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="60" y="778" width="226" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="n70" value="Détection des comptes inactifs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="290" y="778" width="206" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="n71" value="Intérêt légitime (art. 6.1.f)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="500" y="778" width="171" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="n72" value="PostgreSQL sur Hetzner (DE)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="675" y="778" width="191" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="n73" value="Durée de vie du compte" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="870" y="778" width="186" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="n74" value="Écriture limitée à une fois toutes les 5 minutes (sobriété)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="1060" y="778" width="296" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="n75" value="DROITS DES PERSONNES comment ils sont techniquement servis" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#c3fae8;strokeColor=#099268;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#099268" parent="1" vertex="1">
                    <mxGeometry x="60" y="852" width="760" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="n76" value="&lt;b&gt;Accès&lt;/b&gt;, GET /api/settings et /api/profile restituent l&#39;intégralité des données du compte." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="82" y="888" width="716" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="n77" value="&lt;b&gt;Rectification&lt;/b&gt;, PATCH sur l&#39;identité, le pseudonyme, l&#39;e-mail, la biographie et l&#39;avatar." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="82" y="928" width="716" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="n78" value="&lt;b&gt;Effacement&lt;/b&gt;, DELETE /api/settings/account, vérification du mot de passe, suppression des objets S3, puis suppression en base propagée &lt;b&gt;en cascade&lt;/b&gt; sur médias, albums, placements et abonnements." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="82" y="968" width="716" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="n79" value="&lt;b&gt;Portabilité&lt;/b&gt;, POST /api/library/download restitue les URL de téléchargement d&#39;un lot, la clé d&#39;API permet une extraction programmatique." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="82" y="1008" width="716" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="n80" value="&lt;b&gt;Opposition / limitation&lt;/b&gt;, La dépublication ramène instantanément un contenu au domaine privé, sans perte ni duplication." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="82" y="1048" width="716" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="n81" value="PRINCIPES APPLIQUÉS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#2f9e44" parent="1" vertex="1">
                    <mxGeometry x="850" y="852" width="750" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="n82" value="&lt;b&gt;Minimisation,&lt;/b&gt;&amp;nbsp;cinq tables suffisent au domaine. Aucune donnée n&#39;est collectée « au cas où », ni géolocalisation, ni EXIF complet, ni traceur publicitaire." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="872" y="888" width="706" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="n83" value="&lt;b&gt;Protection dès la conception,&lt;/b&gt;&amp;nbsp;le privé est l&#39;état par défaut, la publication une action explicite et révocable. L&#39;empreinte du mot de passe et la clé d&#39;API sont exclues des lectures par défaut au niveau du modèle lui-même." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="872" y="938" width="706" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="n84" value="&lt;b&gt;Localisation,&lt;/b&gt;&amp;nbsp;calcul chez un hébergeur européen (Hetzner, Allemagne), services AWS confinés à la région eu-west-3 (Paris). Aucun transfert hors Union européenne. Cloudflare n&#39;assure que la périphérie réseau, sans conservation de contenu." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="872" y="988" width="706" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="n85" value="&lt;b&gt;Sécurité,&lt;/b&gt;&amp;nbsp;chiffrement au repos (AES-256) et en transit (TLS ≥ 1.2, HSTS 2 ans), politique de bucket refusant tout transport non sécurisé, sauvegardes verrouillées par Object Lock." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="872" y="1038" width="706" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="n86" value="Sources, models/*.entity.ts · controllers/settings.controller.ts · services/auth.service.ts · infra/saas/terraform/main.tf · infra/saas/ansible/files/loki.yml, cf. aussi Annexe R" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#adb5bd" parent="1" vertex="1">
                    <mxGeometry x="60" y="1104" width="1300" height="18" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
