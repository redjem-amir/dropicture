                </mxCell>
                <mxCell id="n97" value="Les compteurs matériels (RAPL) ne sont pas exposés sur des machines virtuelles louées. La consommation est donc &lt;b&gt;estimée&lt;/b&gt; par un modèle documenté, dérivé de l&#39;utilisation processeur." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
