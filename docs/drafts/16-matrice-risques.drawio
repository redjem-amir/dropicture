        <mxCell id="c138" value="Réduire" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#495057;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="894" y="762" width="116" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="c139" value="Minimisation dès la conception (cinq tables, aucune donnée superflue), privé par défaut, suppression en cascade servant le droit à l'effacement, hébergement intégralement européen, durées de conservation bornées et documentées, registre simplifié tenu en Annexe F.3, cartographie de conformité en Annexe R." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=8.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="1010" y="762" width="400" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="c140" value="&lt;b&gt;1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ebfbee;strokeColor=#2f9e44;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1410" y="762" width="34" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="c141" value="&lt;b&gt;4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ebfbee;strokeColor=#2f9e44;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1444" y="762" width="34" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="c142" value="&lt;b&gt;4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ebfbee;strokeColor=#2f9e44;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#2f9e44;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1478" y="762" width="46" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="c143" value="&lt;b&gt;Faible&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ebfbee;strokeColor=#2f9e44;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#2f9e44;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1524" y="762" width="82" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="c144" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1606" y="762" width="8" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="c145" value="Criticité brute cumulée &lt;b&gt;73&lt;/b&gt;, criticité résiduelle cumulée &lt;b&gt;31&lt;/b&gt;, soit une réduction de &lt;b&gt;58 %&lt;/b&gt;. Aucun risque ne reste critique après traitement et un seul demeure en zone modérée, R1. Sept risques sur huit relèvent de la réduction, deux sont acceptés en résiduel après réduction, R4 et R6." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e9fac8;strokeColor=#74b816;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="40" y="858" width="1574" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c146" value="Sources : mémoire §11.3.3 (analyse de risques) et §13.2.2 (gestion des risques du projet) · EBIOS Risk Manager (ANSSI) · ISO/IEC 27005 · Annexe A (cartographie du SI) · Annexe U (plan de reprise, scénario S3) · Annexe R (cartographie ISO/IEC 27001 et RGPD)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#adb5bd" parent="1" vertex="1">
          <mxGeometry x="40" y="1139" width="1574" height="18" as="geometry"/>
        </mxCell>
      </root>
