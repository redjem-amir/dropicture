          <mxGeometry x="902" y="702" width="178" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="c42" value="2.  Lecture de la matrice" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#1c7ed6;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="850" width="900" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c43" value="Un identifiant &lt;b&gt;en gras&lt;/b&gt; marque la position du risque avant traitement. Entre parenthèses, sa position après application des mesures en place. Le décalage vers le bas et vers la gauche mesure l'efficacité du traitement. Les quatre bandes de couleur suivent le produit probabilité × impact, faible de 1 à 4, modéré de 5 à 9, élevé de 10 à 14, critique de 15 à 25. Aucune information n'est portée par la seule couleur, chaque case porte aussi le libellé du niveau." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="40" y="876" width="760" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="c44" value="CONVERGENCE ENTRE LE REGISTRE ET LA FEUILLE DE ROUTE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e9fac8;strokeColor=#74b816;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#74b816" parent="1" vertex="1">
          <mxGeometry x="830" y="876" width="784" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="c45" value="Les deux actions prioritaires du plan d'amélioration continue, la haute disponibilité de la supervision et l'exercice de restauration périodique, répondent exactement aux deux risques les plus critiques du registre, R1 et R5. La feuille de route ne suit pas l'envie, elle suit le registre." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9.5;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
          <mxGeometry x="844" y="906" width="756" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c46" value="&lt;b&gt;Faible&lt;/b&gt;  ·  criticité 1 à 4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ebfbee;strokeColor=#2f9e44;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="40" y="990" width="380" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c47" value="&lt;b&gt;Modéré&lt;/b&gt;  ·  criticité 5 à 9" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#fff9db;strokeColor=#f59f00;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="438" y="990" width="380" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c48" value="&lt;b&gt;Élevé&lt;/b&gt;  ·  criticité 10 à 14" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffe8cc;strokeColor=#f76707;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="836" y="990" width="380" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c49" value="&lt;b&gt;Critique&lt;/b&gt;  ·  criticité 15 à 25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffe3e3;strokeColor=#e03131;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
          <mxGeometry x="1234" y="990" width="380" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c50" value="Sources : mémoire §11.3.3 et §13.2.2 · EBIOS Risk Manager (ANSSI), atelier 4, scénarios opérationnels · ISO/IEC 27005 · Annexe Y (provision pour aléas adossée à cinq de ces risques) · Annexe Z (plan de maintenance, revue semestrielle du registre)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#adb5bd" parent="1" vertex="1">
          <mxGeometry x="40" y="1139" width="1574" height="18" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
