                <mxCell id="n59" value="&lt;b&gt;«include»&lt;/b&gt;&amp;nbsp;tout cas de la zone protégée inclut &lt;i&gt;Se connecter&lt;/i&gt;, la garde de route du frontend et la stratégie Passport du backend rejettent toute requête sans session valide." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
