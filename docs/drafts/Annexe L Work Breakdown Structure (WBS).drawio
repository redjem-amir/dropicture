                </mxCell>
                <mxCell id="n82" value="Sur un projet à dominante DevOps, les exigences non fonctionnelles pèsent plus lourd que les fonctionnelles, c&#39;est le fait marquant de cette décomposition." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e9fac8;strokeColor=#74b816;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
                    <mxGeometry x="82" y="976" width="716" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="n83" value="USAGE DE LA WBS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d0ebff;strokeColor=#1c7ed6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#1c7ed6" parent="1" vertex="1">
                    <mxGeometry x="850" y="900" width="750" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="n84" value="Référentiel unique pour l&#39;estimation de charge, l&#39;affectation des travaux et le suivi du reste-à-faire. Chaque lot est valorisé au TJM de 500 €, ce qui alimente le chiffrage à trois niveaux (global, conception, déploiement). Les dépendances entre lots sont formalisées par le PERT (cf. Annexe M) et leur ordonnancement par le Gantt (cf. Annexe N). La matrice RACI (cf. Annexe L bis) attribue à chaque lot un unique décideur redevable." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="872" y="936" width="706" height="78" as="geometry"/>
                </mxCell>
