                <mxCell id="n79" value="&lt;b&gt;Fonctionnel&lt;/b&gt;&amp;nbsp;3 lots · 93 j-h · 46 500 € · 45 %" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
