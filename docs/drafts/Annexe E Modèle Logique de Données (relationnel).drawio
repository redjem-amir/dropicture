                <mxCell id="n29" value="parcours inverse des associations" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#495057" parent="1" vertex="1">
                    <mxGeometry x="462" y="992" width="366" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="n30" value="Les brouillons privés étant majoritaires en volume, l&#39;index du fil public ne référence que les lignes réellement publiées, moins d&#39;espace occupé, lectures plus rapides." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
                    <mxGeometry x="112" y="1026" width="706" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="n31" value="INTÉGRITÉ &amp; CONFORMITÉ" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe3e3;strokeColor=#e03131;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#e03131" parent="1" vertex="1">
                    <mxGeometry x="870" y="760" width="690" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="n32" value="&lt;b&gt;Cascade = socle du droit à l&#39;effacement.&lt;/b&gt; Supprimer un compte fait disparaître ses médias, albums, placements et liens d&#39;abonnement, le service supprime en parallèle les objets S3 correspondants." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="892" y="798" width="646" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="n33" value="&lt;b&gt;Références douces.&lt;/b&gt; avatarMediaId et coverMediaId passent à NULL plutôt que de bloquer la suppression d&#39;un média, la conservation d&#39;un pointeur ne doit jamais empêcher un effacement." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="892" y="860" width="646" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="n34" value="&lt;b&gt;Clés composites.&lt;/b&gt; placements et follows n&#39;ont aucun identifiant technique, la clé primaire est le couple métier, ce qui allège le stockage et l&#39;indexation." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="892" y="922" width="646" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="n35" value="&lt;b&gt;Contrainte de cohérence.&lt;/b&gt; Une contrainte CHECK interdit l&#39;auto-abonnement au niveau de la base, pas seulement dans le code." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="892" y="984" width="646" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="n36" value="&lt;b&gt;Lecture&lt;/b&gt;&amp;nbsp;clé primaire soulignée en gras, clé étrangère en italique. Rouge, intégrité en cascade. Violet, mise à NULL." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
                    <mxGeometry x="90" y="1075" width="750" height="30" as="geometry"/>
                </mxCell>
