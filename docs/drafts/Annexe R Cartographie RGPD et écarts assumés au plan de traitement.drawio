        <mxCell id="c34" value="Le privé est l'état par défaut, la publication est une action explicite. Mot de passe et clé d'API exclus des lectures par défaut au niveau du modèle." style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=3;spacingLeft=6" parent="1" vertex="1">
