                </mxCell>
                <mxCell id="c85" value="Ces montants sont des estimations et non des factures. Ils dépendent du volume réellement stocké et diffusé, deux variables qui croissent avec l&#39;usage. Le seul poste véritablement variable est la diffusion, et c&#39;est précisément celui que l&#39;architecture de profil public en page statique maintient bas, le coût étant décorrélé du nombre de visiteurs (cf. Annexe W, KF2)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff3bf;strokeColor=#f59f00;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
                    <mxGeometry x="40" y="830" width="1574" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c86" value="3.  Ce que le chiffrage d&#39;exploitation dit de l&#39;éco-conception" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#1c7ed6;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="40" y="886" width="900" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="c87" value="SOBRIÉTÉ MATÉRIELLE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#2f9e44" parent="1" vertex="1">
                    <mxGeometry x="40" y="912" width="508" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="c88" value="Quatre nœuds au total, dimensionnés au plus juste depuis terraform.tfvars. Le choix de Docker Swarm plutôt que Kubernetes évite un plan de contrôle permanent, humain et matériel (cf. Annexe J, ADR-005)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="54" y="942" width="480" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="c89" value="COÛT DÉCORRÉLÉ DU TRAFIC" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d0ebff;strokeColor=#1c7ed6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#1c7ed6" parent="1" vertex="1">
                    <mxGeometry x="573" y="912" width="508" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="c90" value="Le site public est un export statique servi depuis un cache d&#39;un an. Un pic de visite ne fait pas monter la facture de calcul, seulement celle de diffusion, plafonnée par une classe de prix restreinte." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#dee2e6;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontColor=#495057;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
