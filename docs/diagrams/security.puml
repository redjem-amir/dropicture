@startuml security
title dropicture - Session and token security (opaque sliding sessions, rotation, reuse detection)
footer Author: Amir Redjem   |   2026-06-05   |   v1.0

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam ArrowColor #2F6FED
skinparam ArrowFontColor #41505F
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #FDF4F4
skinparam ParticipantBorderColor #E6BCBC
skinparam ActorBackgroundColor #EEF4FF
skinparam ActorBorderColor #B8CDF3
skinparam DatabaseBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #B7E0C9
skinparam CollectionsBackgroundColor #FDF4F4
skinparam CollectionsBorderColor #E6BCBC
skinparam SequenceLifeLineBorderColor #B8C4D0
skinparam SequenceDividerBackgroundColor #EEF4FF
skinparam SequenceDividerFontColor #41505F
skinparam SequenceGroupBackgroundColor #F6F1FC
skinparam SequenceGroupBorderColor #CDBCE8
skinparam SequenceGroupHeaderFontColor #41505F
skinparam noteBackgroundColor #FFF6EC
skinparam noteBorderColor #F3B27A

actor "User (browser)\nUserProvider refresh timer" as user
participant "Next.js edge\nmiddleware (proxy.ts)\nSSR (session.ts)" as edge
participant "NestJS API\nAuthController + AuthService" as api
database "Redis\nsession:{sid}, rotated:{sid}:{nonce}\nlock:rotate:{sid}, account:sessions:{id}\nrate:* counters" as redis
database "PostgreSQL\naccounts (status, tokenVersion,\nargon2id hash)" as pg

note over user, pg
  Opaque session cookie = **sid.nonce** (no JWT).
  All state lives in Redis; the cookie is only a lookup key.
  Windows: access 5 min, idle 30 min (sliding), absolute 8 h.
  Every /api/* call is rate-limited and, in prod, requires the
  Cloudflare cf-connecting-ip header (missing header -> 403).
end note

== Sign in  (POST /api/auth/signin, @Throttle 10/min) ==
user -> api : email + password
api -> pg : find account by email (+ roles)
alt email unknown
  api -> api : argon2id verify DUMMY hash\n(constant time, anti-enumeration)
  api --> user : 401 INVALID_CREDENTIALS
else account found
  api -> api : argon2id verify(password)\nm=19456, t=2, p=1
  alt wrong password or status not active
    api --> user : 401 INVALID_CREDENTIALS\nor 403 (pending / suspended / banned)
  else valid
    api -> api : createSession\nsid = 32B, nonce = 16B (base64url)
    api -> redis : SETEX session:{sid}  (idle TTL 30m)\nscope, roles, tokenVersion, ipHash (sha256/16)\nabsExp +8h, accessExp +5m
    api -> redis : SADD account:sessions:{id}  + EXPIRE 8h
    api -> pg : update lastSeenAt
    api --> user : Set-Cookie session = sid.nonce\nHttpOnly, Secure (prod), SameSite=Lax\n{ expires_in: 300 }
  end
end

== Resolve on navigation / SSR  (POST /api/auth/resolve, 120/min) ==
note over user, edge
  UserProvider schedules a refresh ~60s before accessExpiresAt
  and coordinates tabs via BroadcastChannel. The middleware
  also rotates on navigation when inside the 60s margin.
end note
user -> edge : GET /auth/*  (cookie)
edge -> api : resolve (cookie)
api -> redis : GET session:{sid}
alt nonce matches and not absolute-expired
  api -> redis : sliding: if idle > 30s, rewrite lastUsedAt + TTL
  api --> edge : { sub, scope, roles, accessExpiresAt }
  edge -> edge : hasScope(route) -> /403 if missing, /404 if no route\nadd HSTS, X-Frame DENY, nosniff, Referrer, Permissions
  edge --> user : page
else nonce mismatch and no grace record
  ref over api, redis, pg : Reuse / theft detection
end

== Token rotation  (POST /api/auth/session, 30/min) ==
user -> api : rotate (cookie)
api -> redis : SET lock:rotate:{sid}  NX EX 5s
alt lock already held (concurrent refresh)
  loop up to 6 x 25ms
    api -> redis : GET rotated:{sid}:{nonce}
  end
  api --> user : return cached new cookie, else 401
else lock acquired
  api -> redis : GET session:{sid}
  api -> pg : load account (status, tokenVersion)
  alt inactive / tokenVersion changed / absolute-expired
    api -> redis : DEL session:{sid}  + SREM index
    api --> user : 401 (revoked or expired)
  else valid
    api -> api : new nonce; refresh scope + roles\naccessExp +5m
    api -> redis : SETEX session:{sid}  (new nonce)
    api -> redis : SETEX rotated:{sid}:{oldNonce} = newCookie  TTL 30s\n(grace for in-flight requests)
    api --> user : Set-Cookie session = sid.newNonce\n{ expires_in: 300 }
  end
  api -> redis : DEL lock:rotate:{sid}
end

== Reuse / theft detection ==
note over api
  An old nonce with no grace record means the cookie
  was captured and replayed. Burn everything.
end note
api -> redis : DEL session:{sid}  (terminate)
api -> pg : INCREMENT accounts.tokenVersion\n(invalidates every session at next rotation)
api --> user : 401 -> client redirects to login (expired)

== Sign out  (POST /api/auth/signout, 20/min) ==
user -> api : signout (cookie)
api -> redis : DEL session:{sid}  + SREM account:sessions:{id}
api --> user : Clear-Cookie session

note over user, pg
  Role / scope changes call applyScopesToActiveSessions:
  every session in account:sessions:{id} is rewritten in place,
  so new permissions take effect without forcing a re-login.
end note

@enduml
