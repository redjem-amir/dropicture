                <mxCell id="n38" value="&lt;b&gt;Éco-conception.&lt;/b&gt; L&#39;empreinte mémoire du processus reste bornée quelle que soit la taille du fichier, le corps de la requête n&#39;est jamais chargé intégralement, il est piloté en flux vers S3." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e9fac8;strokeColor=#74b816;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8" parent="1" vertex="1">
                    <mxGeometry x="60" y="1022" width="500" height="82" as="geometry"/>
                </mxCell>
                <mxCell id="n39" value="&lt;b&gt;Privé par défaut.&lt;/b&gt; &lt;i&gt;publishedAt&lt;/i&gt; vaut NULL à l&#39;écriture. Le média n&#39;apparaît ni dans le fil public, ni sur le profil, tant que son propriétaire n&#39;a pas publié." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d3f9d8;strokeColor=#2f9e44;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8" parent="1" vertex="1">
                    <mxGeometry x="580" y="1022" width="500" height="82" as="geometry"/>
                </mxCell>
                <mxCell id="n40" value="&lt;b&gt;Nettoyage garanti.&lt;/b&gt; Tout échec provoque l&#39;abandon de l&#39;envoi multipart et la suppression de l&#39;objet partiel : aucun orphelin ne subsiste dans le bucket." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff3bf;strokeColor=#f59f00;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8" parent="1" vertex="1">
