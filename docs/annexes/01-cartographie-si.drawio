                <mxCell id="n62" value="AWS CloudFront + WAF&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;cdn.dropicture.com&lt;br/&gt;cache immuable 1 an&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" vertex="1" parent="1">
