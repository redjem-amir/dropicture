                </mxCell>
                <mxCell id="n64" value="AWS S3 — sauvegardes&lt;br/&gt;&lt;font style=&#39;font-size:9px&#39;&gt;daily/ · monthly/ · Object Lock&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e9fac8;strokeColor=#74b816;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" vertex="1" parent="1">
