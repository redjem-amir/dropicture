                </mxCell>
                <mxCell id="n79" value="&lt;b&gt;Portabilité&lt;/b&gt; — POST /api/library/download restitue les URL de téléchargement d&#39;un lot ; la clé d&#39;API permet une extraction programmatique." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" vertex="1" parent="1">
                    <mxGeometry x="82" y="1008" width="716" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="n80" value="&lt;b&gt;Opposition / limitation&lt;/b&gt; — La dépublication ramène instantanément un contenu au domaine privé, sans perte ni duplication." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" vertex="1" parent="1">
                    <mxGeometry x="82" y="1048" width="716" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="n81" value="PRINCIPES APPLIQUÉS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#2f9e44" vertex="1" parent="1">
                    <mxGeometry x="850" y="852" width="750" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="n82" value="&lt;b&gt;Minimisation&lt;/b&gt; — cinq tables suffisent au domaine. Aucune donnée n&#39;est collectée « au cas où » : ni géolocalisation, ni EXIF complet, ni traceur publicitaire." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" vertex="1" parent="1">
                    <mxGeometry x="872" y="888" width="706" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="n83" value="&lt;b&gt;Protection dès la conception&lt;/b&gt; — le privé est l&#39;état par défaut, la publication une action explicite et révocable. L&#39;empreinte du mot de passe et la clé d&#39;API sont exclues des lectures par défaut au niveau du modèle lui-même." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" vertex="1" parent="1">
                    <mxGeometry x="872" y="938" width="706" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="n84" value="&lt;b&gt;Localisation&lt;/b&gt; — calcul chez un hébergeur européen (Hetzner, Allemagne), services AWS confinés à la région eu-west-3 (Paris). Aucun transfert hors Union européenne. Cloudflare n&#39;assure que la périphérie réseau, sans conservation de contenu." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" vertex="1" parent="1">
                    <mxGeometry x="872" y="988" width="706" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="n85" value="&lt;b&gt;Sécurité&lt;/b&gt; — chiffrement au repos (AES-256) et en transit (TLS ≥ 1.2, HSTS 2 ans), politique de bucket refusant tout transport non sécurisé, sauvegardes verrouillées par Object Lock." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" vertex="1" parent="1">
                    <mxGeometry x="872" y="1038" width="706" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="n86" value="Sources : models/*.entity.ts · controllers/settings.controller.ts · services/auth.service.ts · infra/saas/terraform/main.tf · infra/saas/ansible/files/loki.yml — cf. aussi Annexe R" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#adb5bd" vertex="1" parent="1">
                    <mxGeometry x="60" y="1104" width="1300" height="18" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>