                <mxCell id="n72" value="&lt;b&gt;P1 → Membre&lt;/b&gt;&amp;nbsp;cookie de session &lt;i&gt;httpOnly&lt;/i&gt; et durée de validité de la fenêtre d&#39;accès. Aucune donnée personnelle dans le cookie." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="82" y="976" width="1186" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="n73" value="&lt;b&gt;P2 → Membre&lt;/b&gt;&amp;nbsp;identifiant du média, dimensions, URL CDN, taille, date de prise de vue, état de publication (toujours &lt;i&gt;false&lt;/i&gt; à la création)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="82" y="1006" width="1186" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="n74" value="&lt;b&gt;P4 → Visiteur / Client API&lt;/b&gt;&amp;nbsp;profil public, galerie publiée, compteurs, curseur de pagination. Jamais l&#39;adresse e-mail, jamais un média non publié." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
                    <mxGeometry x="82" y="1036" width="1186" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="n75" value="&lt;b&gt;P6 → Exploitant&lt;/b&gt;&amp;nbsp;tableaux de bord agrégés. Les journaux contiennent un identifiant de compte technique (UUID), pas d&#39;identité en clair." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=10" parent="1" vertex="1">
