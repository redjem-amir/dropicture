        <task id="0" uid="dropicture-000" name="Phase 1 — Conception" color="#495057" meeting="false" start="2025-02-03" duration="8" complete="0" thirdDate="2025-02-03" thirdDate-constraint="0" expand="true">
            <notes><![CDATA[Cadrage, veille, architecture et modélisation.]]></notes>
            <task id="1" uid="dropicture-001" name="1.1 Cadrage, veille et cahier des charges" color="#4263eb" meeting="false" start="2025-02-03" duration="4" complete="0" thirdDate="2025-02-03" thirdDate-constraint="0" expand="true">
                <notes><![CDATA[Contexte, problématique, objectifs O1 à O5, veille technologique et réglementaire, besoins fonctionnels et non fonctionnels.]]></notes>
                <depend id="2" type="2" difference="0" hardness="Strong"/>
            </task>
            <task id="2" uid="dropicture-002" name="1.2 Architecture, ADR, modélisation, maquettes" color="#4263eb" meeting="false" start="2025-02-07" duration="4" complete="0" thirdDate="2025-02-07" thirdDate-constraint="0" expand="true">
                <notes><![CDATA[Cartographie du SI (4 niveaux), journal des décisions d'architecture, MCD/MLD, diagrammes UML, maquettes basse fidélité.]]></notes>
                <depend id="3" type="2" difference="0" hardness="Strong"/>
            </task>
        </task>
        <task id="3" uid="dropicture-003" name="M1 — Dossiers de conception validés" color="#495057" meeting="true" start="2025-02-13" duration="1" complete="0" thirdDate="2025-02-13" thirdDate-constraint="0" expand="true">
            <notes><![CDATA[Jalon de contrôle : périmètre fonctionnel figé, choix d'architecture arrêtés et tracés.]]></notes>
            <depend id="5" type="2" difference="0" hardness="Strong"/>
            <depend id="9" type="2" difference="0" hardness="Strong"/>
        </task>
        <task id="4" uid="dropicture-004" name="Phase 2 — Infrastructure" color="#495057" meeting="false" start="2025-02-13" duration="10" complete="0" thirdDate="2025-02-13" thirdDate-constraint="0" expand="true">
            <notes><![CDATA[Provisionnement déclaratif et configuration idempotente.]]></notes>
            <task id="5" uid="dropicture-005" name="2.1 Terraform — Hetzner, Cloudflare, AWS" color="#099268" meeting="false" start="2025-02-13" duration="5" complete="0" thirdDate="2025-02-13" thirdDate-constraint="0" expand="true">
                <notes><![CDATA[Réseau privé, pare-feu, nœuds par rôle, DNS et TLS, S3 et CloudFront, WAF, SSM, état distant verrouillé.]]></notes>
                <depend id="6" type="2" difference="0" hardness="Strong"/>
            </task>
            <task id="6" uid="dropicture-006" name="2.2 Ansible — durcissement, Docker, Swarm, PKI" color="#099268" meeting="false" start="2025-02-20" duration="5" complete="0" thirdDate="2025-02-20" thirdDate-constraint="0" expand="true">
                <notes><![CDATA[Durcissement SSH, Docker Engine, initialisation du Swarm sur le réseau privé, étiquettes de rôle, certificat d'origine, configs et secrets.]]></notes>
                <depend id="7" type="2" difference="0" hardness="Strong"/>
            </task>
        </task>
        <task id="7" uid="dropicture-007" name="M2 — Infrastructure déployée par l&#x27;IaC" color="#495057" meeting="true" start="2025-02-27" duration="1" complete="0" thirdDate="2025-02-27" thirdDate-constraint="0" expand="true">
            <notes><![CDATA[Jalon de contrôle : cluster reconstructible intégralement par le code.]]></notes>
            <depend id="13" type="2" difference="0" hardness="Strong"/>
            <depend id="14" type="2" difference="0" hardness="Strong"/>
        </task>
        <task id="8" uid="dropicture-008" name="Phase 3 — Développement" color="#495057" meeting="false" start="2025-02-13" duration="21" complete="0" thirdDate="2025-02-13" thirdDate-constraint="0" expand="true">
            <notes><![CDATA[Backend, application authentifiée et site vitrine.]]></notes>
            <task id="9" uid="dropicture-009" name="3.1 Backend API (NestJS)" color="#7048e8" meeting="false" start="2025-02-13" duration="12" complete="0" thirdDate="2025-02-13" thirdDate-constraint="0" expand="true">
                <notes><![CDATA[Socle, session opaque, bibliothèque et téléversement en flux, albums, publication, profil, découverte, paramètres, API publique, modèle de données et 218 tests. LOT DU CHEMIN CRITIQUE.]]></notes>
                <depend id="10" type="2" difference="0" hardness="Strong"/>
                <depend id="14" type="2" difference="0" hardness="Strong"/>
            </task>
            <task id="10" uid="dropicture-010" name="3.2 Frontend et site vitrine (Next.js)" color="#7048e8" meeting="false" start="2025-03-03" duration="7" complete="0" thirdDate="2025-03-03" thirdDate-constraint="0" expand="true">
                <notes><![CDATA[Application authentifiée, garde de route et rotation de session, pages du fil, de la bibliothèque, du profil et des paramètres, site vitrine et profil public statique. Marge de 8 jours.]]></notes>
                <depend id="11" type="2" difference="0" hardness="Strong"/>
            </task>
        </task>
        <task id="11" uid="dropicture-011" name="M3 — Application fonctionnelle" color="#495057" meeting="true" start="2025-03-12" duration="1" complete="0" thirdDate="2025-03-12" thirdDate-constraint="0" expand="true">
            <notes><![CDATA[Jalon de contrôle : parcours complet exécutable de bout en bout.]]></notes>
            <depend id="17" type="2" difference="0" hardness="Strong"/>
        </task>
        <task id="12" uid="dropicture-012" name="Phase 4 — DevOps" color="#495057" meeting="false" start="2025-02-27" duration="18" complete="0" thirdDate="2025-02-27" thirdDate-constraint="0" expand="true">
            <notes><![CDATA[Sécurité, chaîne de livraison et observabilité.]]></notes>
            <task id="13" uid="dropicture-013" name="4.1 Sécurité et conformité" color="#f76707" meeting="false" start="2025-02-27" duration="6" complete="0" thirdDate="2025-02-27" thirdDate-constraint="0" expand="true">
                <notes><![CDATA[Durcissement réseau et système, socket-proxy, Argon2id, quotas, en-têtes, chaîne DevSecOps Trivy et SBOM, cartographie ISO/IEC 27001 et RGPD. Marge de 11 jours.]]></notes>
            </task>
            <task id="14" uid="dropicture-014" name="4.2 Chaîne CI/CD (GitHub Actions)" color="#f76707" meeting="false" start="2025-03-03" duration="8" complete="0" thirdDate="2025-03-03" thirdDate-constraint="0" expand="true">
                <notes><![CDATA[Workflow de déploiement SaaS, étiquetage par SHA de commit, portes de qualité et de sécurité bloquantes, workflows du site vitrine, sauvegarde, restauration et destruction. LOT DU CHEMIN CRITIQUE.]]></notes>
                <depend id="15" type="2" difference="0" hardness="Strong"/>
            </task>
            <task id="15" uid="dropicture-015" name="4.3 Observabilité" color="#f76707" meeting="false" start="2025-03-13" duration="7" complete="0" thirdDate="2025-03-13" thirdDate-constraint="0" expand="true">
                <notes><![CDATA[Prometheus et cibles dérivées de Terraform, Loki et Alloy, trois tableaux de bord Grafana provisionnés, dix règles d'alerte et Alertmanager, estimation énergétique. LOT DU CHEMIN CRITIQUE.]]></notes>
                <depend id="16" type="2" difference="0" hardness="Strong"/>
            </task>
        </task>
        <task id="16" uid="dropicture-016" name="M4 — Pipeline et observabilité en place" color="#495057" meeting="true" start="2025-03-24" duration="1" complete="0" thirdDate="2025-03-24" thirdDate-constraint="0" expand="true">
            <notes><![CDATA[Jalon de contrôle : livraison continue opérationnelle et système observable.]]></notes>
            <depend id="17" type="2" difference="0" hardness="Strong"/>
        </task>
        <task id="17" uid="dropicture-017" name="Phase 5 — Clôture" color="#495057" meeting="false" start="2025-03-24" duration="5" complete="0" thirdDate="2025-03-24" thirdDate-constraint="0" expand="true">
            <notes><![CDATA[Documentation, capitalisation et soutenance.]]></notes>
            <task id="18" uid="dropicture-018" name="5.1 Dossier technique, mémoire et soutenance" color="#2f9e44" meeting="false" start="2025-03-24" duration="5" complete="0" thirdDate="2025-03-24" thirdDate-constraint="0" expand="true">
                <notes><![CDATA[Dossier technique et annexes, mémoire RNCP, runbooks d'exploitation, support de soutenance, rétrospective et plan d'amélioration continue. LOT DU CHEMIN CRITIQUE.]]></notes>
                <depend id="19" type="2" difference="0" hardness="Strong"/>
            </task>
        </task>
        <task id="19" uid="dropicture-019" name="M5 — Dossier technique et retour d&#x27;expérience" color="#495057" meeting="true" start="2025-03-31" duration="1" complete="0" thirdDate="2025-03-31" thirdDate-constraint="0" expand="true">
            <notes><![CDATA[Jalon final : livrables de certification complets, plan d'amélioration chiffré.]]></notes>
        </task>
