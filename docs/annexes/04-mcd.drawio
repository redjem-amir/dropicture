                <mxCell id="n28" value="&lt;b&gt;RG2&lt;/b&gt;&amp;nbsp;Un média est privé tant que &lt;i&gt;publie_le&lt;/i&gt; n&#39;est pas renseigné. La publication est une action explicite et réversible de son propriétaire." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="122" y="700" width="496" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="n29" value="&lt;b&gt;RG3&lt;/b&gt;&amp;nbsp;Le rôle distingue un média de contenu d&#39;un avatar. Un avatar est public par construction et ne peut être ni publié ni dépublié individuellement." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="122" y="742" width="496" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="n30" value="&lt;b&gt;RG4&lt;/b&gt;&amp;nbsp;Un album appartient à un seul compte ; deux albums d&#39;un même compte ne peuvent porter le même titre." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="122" y="784" width="496" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="n31" value="&lt;b&gt;RG5&lt;/b&gt;&amp;nbsp;Un média peut figurer dans plusieurs albums, à une position d&#39;affichage propre à chaque album. Retirer un média d&#39;un album ne le supprime pas de la bibliothèque." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="122" y="826" width="496" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="n32" value="&lt;b&gt;RG6&lt;/b&gt;&amp;nbsp;Un compte ne peut pas se suivre lui-même, un couple (suiveur, suivi) est unique." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=9;fontColor=#212529;align=left;verticalAlign=middle;spacing=6;spacingLeft=8" parent="1" vertex="1">
                    <mxGeometry x="122" y="868" width="496" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="n33" value="LECTURE DES CARDINALITÉS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dee2e6;strokeColor=#495057;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#495057" parent="1" vertex="1">
                    <mxGeometry x="700" y="800" width="900" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="n34" value="&lt;b&gt;0,n&lt;/b&gt;&amp;nbsp;participation facultative, plusieurs occurrences possibles      &lt;b&gt;1,1&lt;/b&gt;&amp;nbsp;participation obligatoire et unique      &lt;b&gt;0,1&lt;/b&gt;&amp;nbsp;participation facultative et unique" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
                    <mxGeometry x="722" y="836" width="856" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="n35" value="Les associations &lt;i&gt;ILLUSTRER&lt;/i&gt; et &lt;i&gt;COUVRIR&lt;/i&gt; (en violet) portent des références dites douces : leur disparition met la référence à NULL au lieu de bloquer la suppression." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#adb5bd;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10;fontColor=#212529;align=center;verticalAlign=middle;spacing=6" parent="1" vertex="1">
